         RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
         RowBox[{"Directory", "[", "]"}]}], "]"}]}], ",", 
      " ", "\"\<BlackBox\>\""}], "}"}], "]"}], "]"}], ";"}], "\n", 
