  RowBox[{"Quiet", "[", 
   RowBox[{"Remove", " ", "/@", " ", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\"\<Global`\>\"", " ", "<>", " ", "#"}], " ", "&"}], " ", "/@",
        " ", 
       RowBox[{"Names", "[", "\"\<HubertKolcz`BlackBox`*\>\"", "]"}]}], ",", 
      " ", "NameQ"}], "]"}]}], "]"}], ";"}], "\n", 
