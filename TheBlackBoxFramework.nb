   \"g7Anchor\" -> g7AxisRank == 2 && g7CascadeDLA == 3 && g7LeafDLA < 3,
   \"oq1Separation\" -> oq1RankQuantum == 2 && oq1RankBlind == 0 && \
oq1ZColumn < 10^-10,
   \"oq2ForgerFlagged\" -> oq2Dmax > 10 oq2tMax && Abs[oq2Dmax/oq2tMax - 56] \
< 2,
   \"cvColumn\" -> cvPassive2[\"dim\"] == 4 && cvPassive2[\"compact\"] &&
      cvActive2[\"dim\"] == 10 && ! cvActive2[\"compact\"] &&
      cvActive1[\"dim\"] == 3 && ! cvActive1[\"compact\"],
   \"mapEmbedded\" -> FileExistsQ[certMapFile]
   |>;
Column[{section3Check, \"S3 OK\" -> And @@ Values[section3Check]}]\
\>", "Input",ExpressionUUID->"b246620b-14b4-9448-9e5a-062c2fe98fe7"],

