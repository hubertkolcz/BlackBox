         RowBox[{"Placed", "[", 
           RowBox[{#2, ",", "Below"}], "]"}]}], "]"}]& ), Editable -> True]},
  "RowWithSeparator"]], "Output",ExpressionUUID->"f3b9ed4e-b96e-3941-bf37-\
34c22d36cf5a"],

Cell["\<\
The same facts, exactly rather than visually \[LongDash] all five adjacent \
dot products vanish identically, the directions are unit vectors, and the \
pentagon's three ceilings are the closed forms promised above:\
\>", "CodeText",ExpressionUUID->"3e34efb3-3d6d-3045-95d2-4f2d81571df8"],

Cell["\<\
Module[{c2, vecs}, c2 = Cos[Pi/5]/(1 + Cos[Pi/5]); vecs = Table[{Sqrt[1 - c2] \
Cos[4 Pi i/5], Sqrt[1 - c2] Sin[4 Pi i/5], Sqrt[c2]}, {i, 0, 4}]; \
{Table[Simplify[vecs[[i]].vecs[[Mod[i, 5] + 1]]], {i, 5}], \
Simplify[vecs[[1]].vecs[[1]]], {2, Sqrt[5], 5/2}}]\
\>", "Input",ExpressionUUID->"a4abc25d-2203-9840-9ec7-52a2d0119e42"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", "1", ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", 
     SqrtBox["5"], ",", 
     FractionBox["5", "2"]}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"9cc80ea5-ddb7-f744-a420-3203b616388c"],

Cell["\<\
Why five, and not fewer? Each observable is dichotomic, and orthogonal \
neighbors force joint measurability, so a cycle of any length is available to \
test. But even cycles saturate the classical bound quantum-mechanically (no \
advantage), and the smallest odd cycle, C3, already collapses: three mutually \
orthogonal directions in a 3-dimensional Hilbert space form a single shared \
context rather than three separate ones (pairwise-compatible sharp \
measurements are here jointly compatible), so no contextuality can appear. C5 \
is the smallest cycle where this collapse does not happen \[LongDash] the \
genuine atom of contextuality.\
\>", "Text",ExpressionUUID->"83c5a8b3-361e-964a-80e4-df2c4fec6a20"],

Cell["\<\
Classical, quantum and ceiling values for the three smallest odd cycles, live \
\[LongDash] C3 collapses to a single value; C5 and C7 do not:\
\>", "CodeText",ExpressionUUID->"694dcf92-0976-bf40-82d5-8900460d758b"],

Cell["\<\
BarChart[{{1, N[thetaOddCycle[3]], 3/2}, {2, N[thetaOddCycle[5]], 5/2}, {3, \
N[thetaOddCycle[7]], 7/2}}, ChartLabels -> {{\"C3\", \"C5\", \"C7\"}, None}, \
ChartLegends -> {\"classical \[Alpha]\", \"quantum \[CurlyTheta]\", \"ceiling \
\[Alpha]*\"}, ChartStyle -> {GrayLevel[0.6], RGBColor[0.2, 0.45, 0.85], \
RGBColor[0.85, 0.55, 0.2]}, ImageSize -> 420]\
\>", "Input",ExpressionUUID->"746b0f55-fb75-d849-8d5c-6327c19acd75"],

