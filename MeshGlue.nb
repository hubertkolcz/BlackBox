           Rational[1, 2], Rational[1, 4] (-1 - 5^Rational[1, 2])}, {
          0.5877852522924731, -0.8090169943749475}], 0.2], 
        GrayLevel[1], 
        InsetBox[
         FormBox[
          StyleBox["\"1/2\"", 10, Bold, StripOnInput -> False], 
          TraditionalForm], 
         NCache[{(Rational[5, 8] + Rational[-1, 8] 5^Rational[1, 2])^
           Rational[1, 2], Rational[1, 4] (-1 - 5^Rational[1, 2])}, {
          0.5877852522924731, -0.8090169943749475}]]}, {
        RGBColor[0.85, 0.55, 0.2], 
        EdgeForm[
         GrayLevel[0.35]], 
        DiskBox[
         NCache[{(Rational[5, 8] + Rational[1, 8] 5^Rational[1, 2])^
           Rational[1, 2], Rational[1, 4] (-1 + 5^Rational[1, 2])}, {
          0.9510565162951535, 0.30901699437494745`}], 0.2], 
        GrayLevel[1], 
        InsetBox[
         FormBox[
          StyleBox["\"1/2\"", 10, Bold, StripOnInput -> False], 
          TraditionalForm], 
         NCache[{(Rational[5, 8] + Rational[1, 8] 5^Rational[1, 2])^
