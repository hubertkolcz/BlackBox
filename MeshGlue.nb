Cell[TextData[{
 "Everything so far used geometry and graph invariants. Now run the pentagon \
as an actual measurement, through the framework's own measurement object: \
each projector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[VerticalSeparator]", 
    SubscriptBox["v", "k"], "\[RightAngleBracket]", "\[LeftAngleBracket]", 
    SubscriptBox["v", "k"], "\[VerticalSeparator]"}], TraditionalForm]],
  ExpressionUUID->"edf4617e-b399-344f-a375-cc6fd42ec962"],
 " becomes a QuantumMeasurementOperator, applied to the handle state. The \
pentagon's five-fold symmetry makes the correct answer unmistakable: all five \
probabilities must be equal, and their sum must be ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyTheta]", "(", 
    SubscriptBox["C", "5"], ")"}], TraditionalForm]],ExpressionUUID->
  "c57bb035-289d-7f41-990a-baca83ee325a"],
 ":"
}], "Text",ExpressionUUID->"352fddcb-27fa-6e43-8ada-a3bbf5efaabe"],

Cell[TextData[{
 "Measure each KCBS projector on the handle state through \
QuantumMeasurementOperator \[LongDash] five equal probabilities ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SqrtBox["5"]], TraditionalForm]],ExpressionUUID->
  "b6984153-af74-9b4e-8d1b-51c2ac5a68a9"],
 ", summing to ",
 Cell[BoxData[
  FormBox[
   SqrtBox["5"], TraditionalForm]],ExpressionUUID->
  "7711c79d-83ac-d84d-8463-0a013ec69694"],
 ":"
}], "CodeText",ExpressionUUID->"eaf72f8a-114b-1a45-b611-c86093a5f362"],

Cell[CellGroupData[{

Cell["\<\
Module[{c2, vecs, projs, handle, means}, c2 = Cos[Pi/5]/(1 + Cos[Pi/5]); vecs \
= N[Table[{Sqrt[1 - c2]*Cos[4*Pi*(i/5)], Sqrt[1 - c2]*Sin[4*Pi*(i/5)], \
Sqrt[c2]}, {i, 0, 4}], 20]; projs = (Outer[Times, #1, #1] & ) /@ vecs; handle \
= QuantumState[{0, 0, 1}, 3]; means = \
Table[QuantumMeasurementOperator[p][handle][\"Mean\"], {p, projs}]; {means, \
Total[means], N[Sqrt[5], 20]}]\
\>", "Input",
 CellOpen->False,ExpressionUUID->"5fea3f16-680e-cf45-8d4e-de1db60d9423"],

