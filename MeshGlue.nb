Cell[TextData[{
 "The schematic above, made computational: each KCBS setting ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "k"], TraditionalForm]],ExpressionUUID->
  "f539dbf3-5a87-b94c-8d67-ae63dff5e2af"],
 " is decomposed into the schematic's own optical elements \[LongDash] \
pairwise beamsplitters BS{i,j} (Givens mode-mixers on two of the three paths) \
\[LongDash] every element built as a QuantumOperator and recomposed through \
QuantumCircuitOperator. The recomposition reproduces each setting's frame to \
machine precision, no \[Pi] phase plate is ever needed (all five settings are \
pure rotations, det = +1), and every setting clicks on the handle state with \
probability exactly ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SqrtBox["5"]], TraditionalForm]],ExpressionUUID->
  "96e17cb1-fe9f-7b47-a95c-207f938a27cc"],
 ":"
}], "CodeText",ExpressionUUID->"f1358403-c4da-ce4e-95f1-6571f537690e"],

Cell[CellGroupData[{

Cell["\<\
Module[{c2, vecs, frame, sf, givens, decompose, build, results, disp, errs, \
probs},
 c2 = Cos[Pi/5]/(1 + Cos[Pi/5]);
 vecs = N[Table[{Sqrt[1 - c2] Cos[4 Pi i/5], Sqrt[1 - c2] Sin[4 Pi i/5],
     Sqrt[c2]}, {i, 0, 4}], 20];
 frame = Function[{a, b}, {a, b, Cross[a, b]}];
 sf = {frame[vecs[[1]], vecs[[2]]], frame[vecs[[3]], vecs[[2]]],
   frame[vecs[[3]], vecs[[4]]], frame[vecs[[5]], vecs[[4]]],
   frame[vecs[[5]], vecs[[1]]]};
 givens[{i_, j_}, th_] := ReplacePart[IdentityMatrix[3],
   {{i, i} -> Cos[th], {j, j} -> Cos[th], {i, j} -> -Sin[th],
    {j, i} -> Sin[th]}];
 decompose[m_] := Module[{a = m, rots = {}, piv, r, x, y, rr, th, g},
   Do[piv = pr[[1]]; r = pr[[2]];
    x = a[[piv, piv]]; y = a[[r, piv]]; rr = Sqrt[x^2 + y^2];
    If[rr > 10^-12, th = ArcTan[x, y];
     g = ReplacePart[IdentityMatrix[3],
       {{piv, piv} -> Cos[th], {r, r} -> Cos[th], {piv, r} -> Sin[th],
        {r, piv} -> -Sin[th]}];
     a = g . a; AppendTo[rots, {{piv, r}, th}]],
    {pr, {{1, 2}, {1, 3}, {2, 3}}}];
   {rots, Diagonal[a]}];
 build[k_] := Module[{rots, d, ops, comp, err, prob, ang, bsRow},
   {rots, d} = decompose[sf[[k]]];
   ops = Join[
     If[Min[Round[d]] < 0,
      {QuantumOperator[DiagonalMatrix[Round[d]], 3, \"Label\" -> \
\"\[Pi]-plate\"]}, {}],
     Table[QuantumOperator[givens[rots[[m, 1]], rots[[m, 2]]], 3,
       \"Label\" -> Row[{\"BS\", rots[[m, 1]]}]], {m, Length[rots], 1, -1}]];
   comp = Normal[QuantumCircuitOperator[ops][\"Matrix\"]];
   err = Max[Abs[comp - sf[[k]]]];
   prob = Abs[(sf[[k]] . {0, 0, 1})[[1]]]^2;
   ang[m_] := Chop[N[rots[[m, 2]]/Degree], 10^-9];
   bsRow = Row[Riffle[Table[Row[{\"BS\", rots[[m, 1]], \": \",
        NumberForm[ang[m], {5, 1}], \"\[Degree]\"}], {m, Length[rots]}], \"   \
\"]];
   {{k, bsRow, If[Min[Round[d]] < 0, \"yes\", \"no\"],
     If[err == 0, \"0 (exact)\", ScientificForm[N[err], 2]],
     NumberForm[N[prob, 11], {11, 10}]}, err, prob}];
 results = Table[build[k], {k, 5}];
 disp = results[[All, 1]]; errs = results[[All, 2]]; probs = results[[All, 3]];
 Column[{
   TableForm[disp,
    TableHeadings -> {None, {\"setting\", \"beamsplitter sequence\",
       \"\[Pi]-plate\", \"max|recomposed \[Minus] frame|\", \"P(click | \
handle)\"}}],
   Row[{\"all five recompose below 10\:207b\.b9\:2074: \", AllTrue[errs, # < \
10^-14 &],
     \"    \[CapitalSigma]P = \", NumberForm[Total[probs], 20],
     \"  and  \[Sqrt]5 = \", NumberForm[N[Sqrt[5], 20], 20]}]},
  Spacings -> 1.2]]\
\>", "Input",
 CellOpen->False,ExpressionUUID->"8576e267-3aca-4043-87af-1dfc711feadf"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TagBox[
      TagBox[GridBox[{
         {
          TagBox["\<\"setting\"\>",
           HoldForm], 
          TagBox["\<\"beamsplitter sequence\"\>",
           HoldForm], 
          TagBox["\<\"\[Pi]-plate\"\>",
           HoldForm], 
          TagBox["\<\"max|recomposed \[Minus] frame|\"\>",
           HoldForm], 
          TagBox["\<\"P(click | handle)\"\>",
           HoldForm]},
         {"1", 
          TemplateBox[{
            TemplateBox[{"\"BS\"", 
              RowBox[{"{", 
                RowBox[{"1", ",", "2"}], "}"}], "\": \"", 
              TagBox[
