       {CapForm["Round"], JoinForm["Round"], 
        {RGBColor[0.55, 0.55, 0.53], Thickness[0.0032], 
         LineBox[NCache[{{-2.7499830056250527`, (Rational[5, 8] + 
              Rational[-1, 8] 5^Rational[1, 2])^
             Rational[1, 2]}, {-3.8680169943749476`, (Rational[5, 8] + 
              Rational[1, 8] 5^Rational[1, 2])^Rational[1, 2]}, {-4.559, 
