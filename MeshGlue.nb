Cell["\<\
The same convergence computed for real \[LongDash] no toy weights: exact gap \
densities (\[CurlyTheta] \[Minus] \[Alpha])/n for finite meshes cut from the \
same infinite word. Blue, open chains of n blocks: the density swings hard \
with where (ddt)\[Infinity] is cut \[LongDash] essentially zero at n = 2 and \
4, up to 0.066 at n = 15 \[LongDash] because at this scale the dangling \
boundary letters still matter. Teal, closed ddt necklaces (n = 3, 6, 9, 12, \
15): no boundary, and already within 0.0002 of the bulk value at n = 9. Both \
drift toward gap(ddt) = 0.0699 (amber dashes), the number that belongs to the \
infinite word rather than to any cutoff; a single unglued pentagon sits at \
\[Sqrt]5 \[Minus] 2 \[TildeTilde] 0.236, far off this scale:\
\>", "CodeText",ExpressionUUID->"e31311b1-7a10-6a41-b358-a1e8fb621f30"],

Cell[CellGroupData[{

Cell["\<\
Module[{thetaSDP, chainWord, ringWord, word, chainD, ringD,
  lim = 0.0698975, blue, tealc, amber},
 blue = RGBColor[0.2, 0.45, 0.85]; tealc = RGBColor[0.06, 0.43, 0.34];
 amber = RGBColor[0.85, 0.55, 0.2];
 thetaSDP[g_Graph] := Module[{n = VertexCount[g], idx, vars, X, cons, sol},
   idx = AssociationThread[VertexList[g] -> Range[n]];
   X = Table[If[i <= j, x[i, j], x[j, i]], {i, n}, {j, n}];
   vars = Flatten[Table[x[i, j], {i, n}, {j, i, n}]];
   cons = Join[{Tr[X] == 1, VectorGreaterEqual[{X, 0}, {\"SemidefiniteCone\", \
n}]},
     Table[With[{p = idx[List @@ e // First], q = idx[List @@ e // Last]},
       X[[p, q]] == 0], {e, EdgeList[g]}]];
   sol = SemidefiniteOptimization[-Total[X, 2], cons, vars];
   -(-Total[X, 2] /. sol)];
 chainWord[letters_List] := Module[{edges, u, v, base},
   edges = {{1, 2}, {2, 3}, {3, 4}, {4, 5}, {5, 1}};
   {u, v} = {2, 3}; base = 5;
   Do[edges = Join[edges, {{u, base + 1}, {base + 1, base + 2},
       {base + 2, base + 3}, {base + 3, v}}];
    {u, v} = If[l === \"d\", {base + 1, base + 2}, {base + 2, base + 1}];
    base += 3, {l, letters}];
   Graph[Range[base], UndirectedEdge @@@ DeleteDuplicates[Sort /@ edges]]];
 ringWord[w_List] := Module[{L = Length[w], edges = {}, u, v, km},
   Do[km = Mod[k - 1, L];
    {u, v} = If[w[[km + 1]] === \"d\", {3 km + 1, 3 km + 2}, {3 km + 2, 3 km \
+ 1}];
    edges = Join[edges, {{u, v}, {u, 3 k + 1}, {3 k + 1, 3 k + 2},
       {3 k + 2, 3 k + 3}, {3 k + 3, v}}], {k, 0, L - 1}];
   Graph[Range[3 L], UndirectedEdge @@@ DeleteDuplicates[Sort /@ edges]]];
 word = Flatten[ConstantArray[{\"d\", \"d\", \"t\"}, 6]];
 chainD = Table[Module[{g = chainWord[Take[word, m - 1]]},
    {m, (thetaSDP[g] - Length[First[FindIndependentVertexSet[g]]])/m}],
   {m, 2, 15}];
 ringD = Table[Module[{g = ringWord[Take[word, L]]},
    {L, (thetaSDP[g] - Length[First[FindIndependentVertexSet[g]]])/L}],
   {L, {3, 6, 9, 12, 15}}];
 Show[
  ListLinePlot[chainD, PlotStyle -> Directive[blue, Thickness[0.004]],
   PlotMarkers -> {Automatic, 7}],
  ListPlot[ringD, PlotStyle -> Directive[tealc, PointSize[0.016]]],
  Graphics[{{amber, Dashed, Thickness[0.004],
     Line[{{1.5, lim}, {15.5, lim}}]},
    Text[Style[\"gap(ddt) = 0.0699\", 9, amber], {13.6, lim + 0.007}],
    Text[Style[\"open chain, cut from (ddt)\[Infinity]\", 9, blue], {5.1, \
0.104}],
    Text[Style[\"closed necklace\", 9, tealc], {4.4, 0.094}]}],
  PlotRange -> {{1.4, 15.6}, {-0.005, 0.115}},
  AxesOrigin -> {1.4, 0},
  AxesLabel -> {Style[\"n\", Italic],
    Row[{\"(\[CurlyTheta] \[Minus] \[Alpha])/\", Style[\"n\", Italic]}]},
  ImageSize -> 480, ImagePadding -> {{55, 22}, {35, 16}}]]\
\>", "Input",
 CellOpen->False,ExpressionUUID->"7bee24b9-b9a9-2d48-9971-38ebf1f4354b"],

