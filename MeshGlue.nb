           0.6, 0.24, 0.11]], {-2.889983005625053, -0.7177852522924731}], 
        {RGBColor[0.2, 0.34, 0.64], Thickness[0.006], 
         Arrowheads[{{0.045, 0.62}}], 
         ArrowBox[
          NCache[{{-2.7499830056250527`, (Rational[5, 8] + 
              Rational[-1, 8] 5^Rational[1, 2])^
             Rational[1, 2]}, {-1.6319830056250524`, (Rational[5, 8] + 
              Rational[1, 8] 5^Rational[1, 2])^
             Rational[1, 2]}}, {{-2.7499830056250527`, 
           0.5877852522924731}, {-1.6319830056250524`, 
           0.9510565162951535}}]]}, 
        {RGBColor[0.55, 0.55, 0.53], Thickness[0.0032], 
         Arrowheads[{{0.03, 0.58}}], 
         ArrowBox[
          NCache[{{-1.6319830056250524`, (Rational[5, 8] + 
              Rational[1, 8] 5^Rational[1, 2])^
