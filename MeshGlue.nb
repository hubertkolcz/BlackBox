             Rational[1, 2]}}, {{-2.7499830056250527`, 
            0.5877852522924731}, {-3.8680169943749476`, 
            0.9510565162951535}, {-4.559, 
             0}, {-3.8680169943749476`, -0.9510565162951535}, \
{-2.7499830056250527`, -0.5877852522924731}, {-2.7499830056250527`, 
            0.5877852522924731}}]], 
         LineBox[NCache[{{-2.7500169943749473`, (Rational[5, 8] + 
              Rational[-1, 8] 5^Rational[1, 2])^
             Rational[1, 2]}, {-1.6319830056250524`, (Rational[5, 8] + 
