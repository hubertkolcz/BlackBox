              Rational[1, 2]}}, {{-2.7499830056250527`, 
           0.5877852522924731}, {-2.7499830056250527`, \
-0.5877852522924731}}]]}, InsetBox[
         StyleBox["\<\"u\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0.6, 0.24, 0.11],
