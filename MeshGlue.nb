Cell["\<\
Now place every landmark on one line, in the essay's own convention \
\[LongDash] the event sum \[CapitalSigma]p \[LongDash] with nothing quoted: \
the classical wall \[Alpha](C5) = 2 is computed by FindIndependentVertexSet, \
the exclusivity-only ceiling \[Alpha]*(C5) = 5/2 by an exact linear program \
over the fractional-packing polytope, the qutrit marker is the \
QuantumMeasurementOperator probability sum itself, and the Lapkiewicz \
measurement is converted from its reported form, -3.893(6) \[RightArrow] \
\[CapitalSigma]p = 2.2233(15). The reported correlation ruler runs beneath, \
tied to this one by \[CapitalSigma]\[LeftAngleBracket]A_k A_(k+1)\
\[RightAngleBracket] = 5 - 4\[CapitalSigma]p:\
\>", "CodeText",ExpressionUUID->"f66cef51-ee47-6b4d-8b26-29ce7e46cee5"],

Cell["\<\
Module[{ink, inkSub, coral, tealc, amber, alphaC, alphaStar, thetaQ, \
measuredP, c2, vecs, projs, handle, vars, tick}, ink = GrayLevel[0.15]; \
inkSub = GrayLevel[0.42]; coral = RGBColor[0.6, 0.24, 0.11]; tealc = \
RGBColor[0.06, 0.43, 0.34]; amber = RGBColor[0.85, 0.55, 0.2]; alphaC = \
Length[First[FindIndependentVertexSet[CycleGraph[5]]]]; vars = Array[x, 5]; \
alphaStar = MaxValue[{Total[vars], And @@ Table[x[i] + x[Mod[i, 5] + 1] <= 1, \
{i, 5}] && And @@ Table[x[i] >= 0, {i, 5}]}, vars]; c2 = Cos[Pi/5]/(1 + \
Cos[Pi/5]); vecs = N[Table[{Sqrt[1 - c2]*Cos[4*Pi*(i/5)], Sqrt[1 - \
c2]*Sin[4*Pi*(i/5)], Sqrt[c2]}, {i, 0, 4}], 20]; projs = (Outer[Times, #1, \
#1] & ) /@ vecs; handle = QuantumState[{0, 0, 1}, 3]; thetaQ = \
N[Total[Table[QuantumMeasurementOperator[p][handle][\"Mean\"], {p, projs}]]]; \
measuredP = (5 - -3.893)/4; tick[x0_, lbl_] := {{GrayLevel[0.45], Line[{{x0, \
-0.05}, {x0, 0.05}}]}, Text[Style[lbl, 10, inkSub], {x0, -0.15}]}; \
Graphics[{{FaceForm[GrayLevel[0.94]], Rectangle[{1.86, -0.32}, {alphaC, \
0.32}]}, Text[Style[\"every noncontextual\\nmodel lands here\", 9, inkSub], \
{1.93, 0.}], {GrayLevel[0.35], Thickness[0.003], Arrowheads[{{0.02, 1}}], \
Arrow[{{1.86, 0}, {2.64, 0}}]}, tick[2.1, \"2.1\"], tick[2.3, \"2.3\"], \
tick[2.4, \"2.4\"], Text[Style[\"stronger contextuality \[LongRightArrow]\", \
10, inkSub], {2.45, 0.22}], Text[Style[\"\[CapitalSigma]p\", 12, ink], \
{2.615, 0.13}], {ink, Thickness[0.006], Line[{{alphaC, -0.32}, {alphaC, \
0.32}}]}, Text[Style[\"classical bound\\n\[Alpha](C5) = 2\", 11, Bold, ink], \
{alphaC, 0.52}], {amber, Thickness[0.006], Line[{{N[alphaStar], -0.32}, \
{N[alphaStar], 0.32}}]}, Text[Style[\"exclusivity-only \
ceiling\\n\[Alpha]*(C5) = 5/2\", 11, Bold, Darker[amber, 0.2]], \
{N[alphaStar], 0.52}], {tealc, Thickness[0.005], Line[{{thetaQ, -0.13}, \
{thetaQ, 0.13}}]}, {tealc, Disk[{thetaQ, 0}, 0.006]}, Text[Style[\"qutrit: \
\[CapitalSigma]p = \[Sqrt]5 \[TildeTilde] 2.236\\n(QuantumMeasurementOperator \
sum)\", 10, tealc], {thetaQ + 0.04, 0.5}], {coral, Disk[{measuredP, 0}, \
0.006]}, {coral, Thickness[0.0035], Line[{{measuredP, -0.22}, {measuredP, \
-0.02}}]}, Text[Style[\"single photon (Lapkiewicz 2011)\\n\[CapitalSigma]p = \
2.2233(15)\", 10, coral], {measuredP - 0.075, -0.36}], Text[Style[\"same fact \
on the reported ruler:  \[CapitalSigma]\[LeftAngleBracket]A_k A_k+1\
\[RightAngleBracket] = 5 - 4\[CapitalSigma]p\", 10, GrayLevel[0.35]], {2.25, \
-0.55}], {GrayLevel[0.6], Thickness[0.002], Line[{{1.86, -0.68}, {2.64, \
-0.68}}]}, {GrayLevel[0.6], Line[{{alphaC, -0.71}, {alphaC, -0.65}}], \
Line[{{thetaQ, -0.71}, {thetaQ, -0.65}}], Line[{{N[alphaStar], -0.71}, \
{N[alphaStar], -0.65}}]}, {coral, Line[{{measuredP, -0.71}, {measuredP, \
-0.65}}]}, Text[Style[\"-3\", 9, inkSub], {alphaC, -0.79}], Text[Style[\"5-4\
\[Sqrt]5 \[TildeTilde] -3.944\", 9, inkSub], {thetaQ, -0.79}], \
Text[Style[\"-5\", 9, inkSub], {N[alphaStar], -0.79}], \
Text[Style[\"(measured: -3.893(6))\", 9, inkSub], {thetaQ, -0.9}]}, PlotRange \
-> {{1.83, 2.7}, {-1., 0.72}}, AspectRatio -> 0.45, ImageSize -> 640, \
Background -> White]]\
\>", "Input",ExpressionUUID->"6d8c1f7d-3595-784b-9a2d-ff0859c88d21"],

