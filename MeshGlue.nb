     "0.44721359549995793928183473374625524709`15.163858242927772", ",", 
     "0.44721359549995793928183473374625524709`15.163858242927772", ",", 
     "0.44721359549995793928183473374625524709`14.825478516232122"}], "}"}], ",",
    "2.23606797749978969640917366873127623544`15.05302955554459", ",", 
   "2.23606797749978969640917366873127623544`20."}], "}"}]], "Output",Expressi\
onUUID->"7042da60-3cfb-7940-8eba-e7617f343ec1"]
}, Open  ]],

Cell[TextData[{
 "The full KCBS inequality now follows from the same pipeline. Each event \
becomes a dichotomic observable ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "k"], "=", 
    RowBox[{"1", "-", 
     RowBox[{"2", 
      RowBox[{"\[VerticalSeparator]", 
       SubscriptBox["v", "k"], "\[RightAngleBracket]", "\[LeftAngleBracket]", 
       SubscriptBox["v", "k"], "\[VerticalSeparator]"}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"e6b23bb5-39da-9541-a65c-433eaf19c21e"],
 "; adjacent pairs commute (their directions are orthogonal), so each product \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "k"], 
    SubscriptBox["A", 
     RowBox[{"k", "+", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "8f470fcb-8441-1642-a30d-ae242332a2ae"],
 " is itself a single jointly-measurable observable \[LongDash] one \
measurement context per pentagon edge. Any noncontextual assignment of \
pre-existing \[PlusMinus]1 values obeys ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalSigma]", "\[LeftAngleBracket]", 
     SubscriptBox["A", "k"], 
     SubscriptBox["A", 
      RowBox[{"k", "+", "1"}]], "\[RightAngleBracket]"}], "\[GreaterEqual]", 
    RowBox[{"-", "3"}]}], TraditionalForm]],ExpressionUUID->
  "5f87afda-cd31-814d-9404-e0a4c439b370"],
 "; the qutrit's five contexts each return ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    SubscriptBox["A", "k"], 
    SubscriptBox["A", 
     RowBox[{"k", "+", "1"}]], "\[RightAngleBracket]", "=", 
    RowBox[{"1", "-", 
     FractionBox["4", 
      SqrtBox["5"]]}], "\[TildeTilde]", 
    RowBox[{"-", "0.789"}]}], TraditionalForm]],ExpressionUUID->
  "38ffbede-5a64-bc46-afc8-e565186ae9c7"],
 ", summing to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"5", "-", 
     RowBox[{"4", 
      SqrtBox["5"]}]}], "\[TildeTilde]", 
    RowBox[{"-", "3.944"}]}], TraditionalForm]],ExpressionUUID->
  "72fee0a4-3ddd-9a40-a6b0-37ca0fedae8d"],
 ". This negative correlation form is the one experiments report \[LongDash] \
and it is the event form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalSigma]", "p"}], TraditionalForm]],ExpressionUUID->
  "c6f2cc3a-1579-574c-9f07-e6a1313d76d0"],
 " in disguise: adjacent projector products vanish identically, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalSigma]", "\[LeftAngleBracket]", 
     SubscriptBox["A", "k"], 
     SubscriptBox["A", 
      RowBox[{"k", "+", "1"}]], "\[RightAngleBracket]"}], "=", 
    RowBox[{"5", "-", 
     RowBox[{"4", "\[CapitalSigma]", "p"}]}]}], TraditionalForm]],
  ExpressionUUID->"e509638e-9210-124e-b2bf-5ead2a965457"],
 " exactly \[LongDash] an affine change of ruler and nothing more. The last \
entry below converts the measured correlation sum back onto the event ruler \
and lands on ",
 Cell[BoxData[
  FormBox[
   SqrtBox["5"], TraditionalForm]],ExpressionUUID->
  "fa7e40dc-d15c-484e-9279-13ed4bf268d8"],
 " \[LongDash] the same number the five projector probabilities summed to \
above:"
}], "Text",ExpressionUUID->"8420f13b-4869-014b-b669-1eb5ddf64943"],

Cell["\<\
Measure the five contexts \[LongDash] the commuting products A_k A_(k+1) \
\[LongDash] through QuantumMeasurementOperator, sum them against the \
noncontextual bound -3, and convert back to the event ruler:\
\>", "CodeText",ExpressionUUID->"f477242e-a961-a94d-a0a8-92f1164a0ada"],

Cell[CellGroupData[{

Cell["\<\
Module[{c2, vecs, projs, obs, handle, prod, corr}, c2 = Cos[Pi/5]/(1 + \
Cos[Pi/5]); vecs = N[Table[{Sqrt[1 - c2]*Cos[4*Pi*(i/5)], Sqrt[1 - \
c2]*Sin[4*Pi*(i/5)], Sqrt[c2]}, {i, 0, 4}], 20]; projs = (Outer[Times, #1, \
#1] & ) /@ vecs; obs = (IdentityMatrix[3] - 2*#1 & ) /@ projs; handle = \
QuantumState[{0, 0, 1}, 3]; prod[k_] := Module[{m = obs[[k]] . obs[[Mod[k, 5] \
+ 1]]}, (m + ConjugateTranspose[m])/2]; corr = \
Table[QuantumMeasurementOperator[prod[k]][handle][\"Mean\"], {k, 5}]; {corr, \
Total[corr], N[5 - 4*Sqrt[5], 20], -3, (5 - Total[corr])/4}]\
\>", "Input",
 CellOpen->False,ExpressionUUID->"75a5161a-f282-ac48-9acf-effb08608058"],

