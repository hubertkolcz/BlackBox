Cell["\<\
That dormancy theorem for nine-sided-and-larger shapes is exactly what makes \
the last stage surprising. It has a loophole, and the loophole has the shape \
of a pentagon.\
\>", "Text",ExpressionUUID->"4e7ae5d5-52bb-d04b-8522-b883fc6d86fc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Stage 11 \[LongDash] Where \[Omega]=17 Comes In: the Pentagon as \
Catalyst", "Section",ExpressionUUID->"5cc1dc83-f759-234f-91ef-11e8e8612d4b"],

Cell["\<\
The dormancy theorem's proof relies on a specific trick, and that trick has a \
loophole. Throw in just one pentagon alongside three copies of the nine-sided \
shape, and the pentagon's own small size lets it dodge the very step the \
proof depends on. So the question became sharp: does mixing in a pentagon \
actually wake up the effect in this bigger, otherwise-inert combination? The \
signature to look for is a mutually-connected cluster \[LongDash] a clique \
\[LongDash] of size 2\:2074 + 1 = 17 inside the co-normal product C9 \
\[Vee] C9 \[Vee] C9 \[Vee] C5. On 2026-07-14, an independently verified \
clique of exactly that size was found.\
\>", "Text",ExpressionUUID->"e8355f65-5a98-7942-b71f-b401e9e6908b"],

Cell["The co-normal product C9\[Vee]C9\[Vee]C9\[Vee]C5 is genuinely \
4-dimensional. The three C9 factors give real 3D structure below; drag the \
slider to sweep the fourth dimension \[LongDash] the pentagon catalyst \
\[LongDash] and watch the 17-clique witness light up layer by layer:", \
"CodeText",ExpressionUUID->"d3014dd4-41a2-fe4a-b258-29c56c9aafbe"],

Cell[CellGroupData[{

Cell["Manipulate[\n Module[{activeMask, edgeActive, nActive, pos3D9, verts9, coords9, witness17, witIdx, witCoords, witC5, edgesAll},\n  pos3D9[idx_, r_] := Module[{th}, th = 2 Pi idx/9;\n    r[[1]] {Cos[th[[1]]], Sin[th[[1]]], 0} + r[[2]] {0, Cos[th[[2]]], Sin[th[[2]]]} + r[[3]] {Cos[th[[3]]], 0, Sin[th[[3]]]}];\n  verts9 = Tuples[Range[0, 8], 3];\n  coords9 = pos3D9[#, {2.3, 1.5, 0.8}] & /@ verts9;\n  witness17 = {{0, 0, 0, 0}, {2, 4, 4, 1}, {4, 3, 4, 1}, {6, 7, 3, 1}, {6, 7, 8, 2}, {7, 6, 8, 2}, {7, 8, 7, 2}, {8, 6, 6, 2},\n     {8, 7, 7, 2}, {1, 2, 2, 3}, {3, 1, 2, 3}, {3, 6, 1, 3}, {4, 8, 3, 3}, {5, 5, 1, 3}, {5, 5, 6, 4}, {7, 7, 5, 4}, {8, 8, 5, 4}};\n  witIdx = Position[verts9, Most[#]][[1, 1]] & /@ witness17;\n  witCoords = coords9[[witIdx]];\n  witC5 = witness17[[All, 4]];\n  edgesAll = Subsets[Range[17], {2}];\n  activeMask = (# == c5layer) & /@ witC5;\n  nActive = Count[activeMask, True];\n  edgeActive[e_] := activeMask[[e[[1]]]] || activeMask[[e[[2]]]];\n  Graphics3D[{\n    {GrayLevel[0.7], Opacity[0.25], PointSize[0.006], Point[coords9]},\n    {GrayLevel[0.55], Opacity[0.25], Thickness[0.0015], Line[{witCoords[[#[[1]]]], witCoords[[#[[2]]]]}] & /@ Select[edgesAll, ! edgeActive[#] &]},\n    {RGBColor[.2, .45, .85], Opacity[0.75], Thickness[0.006], Line[{witCoords[[#[[1]]]], witCoords[[#[[2]]]]}] & /@ Select[edgesAll, edgeActive[#] &]},\n    Table[{If[activeMask[[i]], RGBColor[.85, .3, .15], RGBColor[.2, .45, .85]], PointSize[If[activeMask[[i]], 0.026, 0.013]],\n       Point[witCoords[[i]]]}, {i, 17}]\n    }, Boxed -> False, ImageSize -> 420, SphericalRegion -> True, ViewPoint -> {1.5, -2.2, 1.4}, PlotRange -> All,\n   PlotLabel -> Column[{Style[\"C9 ⋁ C9 ⋁ C9 ⋁ C5, the verified 17-clique -- drag to rotate\", Bold, 10],\n      Style[\"C5 layer \" <> ToString[c5layer] <> \": \" <> ToString[nActive] <> \" of the 17 witness events sit here\", 9, GrayLevel[0.45]]}, Alignment -> Center]]\n  ],\n {{c5layer, 0, \"C5 coordinate (the 4th dimension)\"}, {0, 1, 2, 3, 4}},\n ControlPlacement -> Bottom]", "Input", CellOpen -> False, CellLabel -> "In[798]:=", ExpressionUUID -> "5d986421-e76c-425e-ae97-e9a99311ebc4"],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{c5layer$$ = 0, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{{
       Hold[c5layer$$], 0, "C5 coordinate (the 4th dimension)"}, {0, 1, 2, 3, 
      4}, ControlType -> SetterBar}}, Typeset`size$$ = {
    420., {220.64926766222342`, 226.3812010877766}}, Typeset`update$$ = 0, 
    Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, "Variables" :> {c5layer$$ = 0}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{activeMask$, edgeActive$, nActive$, pos3D9$, verts9$, coords9$, 
         witness17$, witIdx$, witCoords$, witC5$, edgesAll$}, pos3D9$[
           Pattern[idx, 
            Blank[]], 
           Pattern[r, 
            Blank[]]] := Module[{th}, th = 2 Pi (idx/9); Part[r, 1] {
               Cos[
                Part[th, 1]], 
               Sin[
                Part[th, 1]], 0} + Part[r, 2] {0, 
               Cos[
                Part[th, 2]], 
               Sin[
                Part[th, 2]]} + Part[r, 3] {
               Cos[
                Part[th, 3]], 0, 
               Sin[
                Part[th, 3]]}]; verts9$ = Tuples[
           Range[0, 8], 3]; 
        coords9$ = Map[pos3D9$[#, {2.3, 1.5, 0.8}]& , verts9$]; 
        witness17$ = {{0, 0, 0, 0}, {2, 4, 4, 1}, {4, 3, 4, 1}, {6, 7, 3, 
          1}, {6, 7, 8, 2}, {7, 6, 8, 2}, {7, 8, 7, 2}, {8, 6, 6, 2}, {8, 7, 
          7, 2}, {1, 2, 2, 3}, {3, 1, 2, 3}, {3, 6, 1, 3}, {4, 8, 3, 3}, {5, 
          5, 1, 3}, {5, 5, 6, 4}, {7, 7, 5, 4}, {8, 8, 5, 4}}; 
        witIdx$ = Map[Part[
            Position[verts9$, 
             Most[#]], 1, 1]& , witness17$]; 
        witCoords$ = Part[coords9$, witIdx$]; 
        witC5$ = Part[witness17$, All, 4]; edgesAll$ = Subsets[
           Range[17], {2}]; activeMask$ = Map[# == c5layer$$& , witC5$]; 
        nActive$ = Count[activeMask$, True]; edgeActive$[
           Pattern[e$, 
            Blank[]]] := Or[
           Part[activeMask$, 
            Part[e$, 1]], 
           Part[activeMask$, 
            Part[e$, 2]]]; Graphics3D[{{
            GrayLevel[0.7], 
            Opacity[0.25], 
            PointSize[0.006], 
            Point[coords9$]}, {
            GrayLevel[0.55], 
            Opacity[0.25], 
            Thickness[0.0015], 
            Map[Line[{
               Part[witCoords$, 
                Part[#, 1]], 
               Part[witCoords$, 
                Part[#, 2]]}]& , 
             Select[edgesAll$, Not[
               edgeActive$[#]]& ]]}, {
            RGBColor[0.2, 0.45, 0.85], 
            Opacity[0.75], 
            Thickness[0.006], 
            Map[Line[{
               Part[witCoords$, 
                Part[#, 1]], 
               Part[witCoords$, 
                Part[#, 2]]}]& , 
             Select[edgesAll$, edgeActive$[#]& ]]}, 
           Table[{
             If[
              Part[activeMask$, i], 
              RGBColor[0.85, 0.3, 0.15], 
              RGBColor[0.2, 0.45, 0.85]], 
             PointSize[
              If[
               Part[activeMask$, i], 0.026, 0.013]], 
             Point[
              Part[witCoords$, i]]}, {i, 17}]}, Boxed -> False, ImageSize -> 
          420, SphericalRegion -> True, ViewPoint -> {1.5, -2.2, 1.4}, 
          PlotRange -> All, PlotLabel -> Column[{
             Style[
             "C9 \[Vee] C9 \[Vee] C9 \[Vee] C5, the verified 17-clique -- \
drag to rotate", Bold, 10], 
             Style[
             "C5 layer " <> ToString[c5layer$$] <> ": " <> ToString[nActive$] <> 
              " of the 17 witness events sit here", 9, 
              GrayLevel[0.45]]}, Alignment -> Center]]], 
      "Specifications" :> {{{
         c5layer$$, 0, "C5 coordinate (the 4th dimension)"}, {0, 1, 2, 3, 
         4}}}, "Options" :> {ControlPlacement -> Bottom}, 
      "DefaultOptions" :> {}],
     ImageSizeCache->{462.6, {263.49545906847345`, 269.2273924940266}},
     SingleEvaluation->True],
