     BackFaceColor->GrayLevel[0.5],
     GraphicsColor->GrayLevel[0.5],
     FontSize->8,
     FontColor->GrayLevel[0.5]], {2.23606797749979, -0.15}], InsetBox[
    StyleBox["\<\"\[Alpha]* = 5/2\"\>",
     StripOnInput->False,
     LineColor->RGBColor[0.85, 0.45, 0.2],
     FrontFaceColor->RGBColor[0.85, 0.45, 0.2],
     BackFaceColor->RGBColor[0.85, 0.45, 0.2],
