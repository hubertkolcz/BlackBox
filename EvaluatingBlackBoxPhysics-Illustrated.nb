      TagBox[GridBox[{
         {
          StyleBox["\<\"C7 \[TensorProduct] C7 \[TensorProduct] C5\"\>",
           StripOnInput->False,
           FontSize->9,
           FontWeight->Bold]},
         {
          StyleBox["\<\"9-clique witness, real 3-torus (drag to rotate)\"\>",
           StripOnInput->False,
