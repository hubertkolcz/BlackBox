              RowBox[{"edgesP", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], "]"}], ",", " ", "Red", ",", 
            " ", "Gray"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "5"}], "}"}]}], "]"}]}], ";", " ", "\n", 
