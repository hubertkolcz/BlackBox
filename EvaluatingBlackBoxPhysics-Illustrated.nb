$CellContext`o3$$, $CellContext`o4$$, $CellContext`o5$$}, $CellContext`k], 
                9], {$CellContext`k, 5}], PlotLabel -> 
            Style["try to glue 5 local pieces into one global picture", 10]], 
           
           Style[$CellContext`msg$, $CellContext`col$, Bold, 11], 
           Style[
           "exhaustive check (this kernel, this session): only 11 of the \
3^5=243 possible combinations glue -- most attempts will fail, on purpose", 
            10]}]], "Specifications" :> {Delimiter, 
        Style[
        "pick one local outcome for each of the 5 edges:", 
         Bold], {{$CellContext`o1$$, "(0,0)", "edge {0,1}"}, {
         "(0,0)", "(0,1)", "(1,0)"}}, {{$CellContext`o2$$, "(0,0)", 
          "edge {1,2}"}, {
         "(0,0)", "(0,1)", "(1,0)"}}, {{$CellContext`o3$$, "(0,0)", 
          "edge {2,3}"}, {
         "(0,0)", "(0,1)", "(1,0)"}}, {{$CellContext`o4$$, "(0,0)", 
          "edge {3,4}"}, {
         "(0,0)", "(0,1)", "(1,0)"}}, {{$CellContext`o5$$, "(0,0)", 
          "edge {4,0}"}, {"(0,0)", "(0,1)", "(1,0)"}}}, "Options" :> {}, 
      "DefaultOptions" :> {}],
     SingleEvaluation->True],
