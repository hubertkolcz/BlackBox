 CellChangeTimes->{3.9930477052329807`*^9},
 CellLabel->
  "Out[736]=",ExpressionUUID->"9ac48a57-8d7a-3c45-8740-bf3629dd3b4c"]
}, Open  ]],

Cell["\<\
Sqrt[5] is the pentagon's analogue of the Tsirelson bound: the most a genuine \
quantum device can score. 5/2 is its analogue of the no-signaling ceiling: \
the most reachable while still respecting no-disturbance. The strip between \
them \[LongDash] the 'meta-optics' overhang \[LongDash] is the adversary's \
room, and it is the territory this whole project is built to survey.\
\>", "Text",ExpressionUUID->"182a2011-8a1f-7942-8919-671511ff59c7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Stage 0 \[LongDash] The Sealed Box", "Section",ExpressionUUID->"4831bc28-b88c-d14f-8c3e-dcd85480cfae"],

Cell["\<\
Imagine a sealed box with some inputs and outputs. It behaves in ways that \
look quantum: its outputs show correlations no ordinary classical device \
should be able to produce. Can you ever be completely certain it is genuinely \
quantum, just by watching what goes in and out, without opening it \
\[LongDash] or could a clever engineer build a purely classical fake that \
produces the exact same numbers? That is the founding question, and the \
honest starting picture has two possible interiors behind one identical \
stream of clicks.\
\>", "Text",ExpressionUUID->"2da1ecd2-754a-224e-b7ca-6011d724d231"],

Cell["\<\
A device you can only poke from outside: same clicks, two candidate interiors:\
\>", "CodeText",ExpressionUUID->"5d6c4dc9-6bab-564a-9d96-d413f352b0d7"],

Cell[CellGroupData[{

Cell["Module[{bx, navy = RGBColor[0.16, 0.28, 0.46], amber = RGBColor[0.80, 0.50, 0.18], ink = GrayLevel[0.18]},\n bx = Function[{x, lbl, guts}, {\n    {GrayLevel[0.14], EdgeForm[{GrayLevel[0.5], Thickness[0.004]}],\n     Rectangle[{x - 0.95, -0.8}, {x + 0.95, 0.8}]}, guts,\n    White, Text[Style[lbl, 8, FontFamily -> \"Helvetica\", Bold], {x, 0.6}]}];\n Graphics[{\n   bx[-2.4, \"interior A: genuinely quantum\",\n    {Lighter[navy, 0.35], Disk[{-2.4, 0.05}, 0.16],\n     White, Text[Style[\"γ\", 13, FontFamily -> \"Helvetica\"], {-2.4, 0.05}],\n     GrayLevel[0.85], Text[Style[\"single photon\", 8, FontFamily -> \"Helvetica\"], {-2.4, -0.45}]}],\n   bx[2.4, \"interior B: classical light\",\n    {amber, Thickness[0.018],\n     Line[{{1.95, 0.3}, {2.85, -0.25}}], Line[{{1.95, -0.25}, {2.85, 0.3}}],\n     GrayLevel[0.85], Text[Style[\"intensity optics\", 8, FontFamily -> \"Helvetica\"], {2.4, -0.55}]}],\n   Arrowheads[0.03], GrayLevel[0.5],\n   Arrow[{{-2.4, 1.5}, {-2.4, 0.85}}], Arrow[{{2.4, 1.5}, {2.4, 0.85}}],\n   ink, Text[Style[\"same measurement in\", 9, FontFamily -> \"Helvetica\"], {0, 1.4}],\n   GrayLevel[0.5], Arrow[{{-2.4, -0.85}, {-2.4, -1.5}}], Arrow[{{2.4, -0.85}, {2.4, -1.5}}],\n   ink, Text[Style[\"identical click statistics out — can you tell which?\", 10, Bold, FontFamily -> \"Helvetica\"], {0, -1.75}]\n   }, ImageSize -> 480, PlotRange -> {{-3.9, 3.9}, {-2.0, 1.6}}]\n]", "Input", CellOpen -> False, CellLabel -> "In[737]:=", ExpressionUUID -> "9d5781e3-a59b-49fe-b13b-0c53aa3a9804"],

Cell[BoxData[GraphicsBox[{{{GrayLevel[0.14], EdgeForm[{GrayLevel[0.5], Thickness[0.004]}], RectangleBox[{-3.3499999999999996, -0.8}, {-1.45, 0.8}]}, {RGBColor[0.45399999999999996, 0.532, 0.649], DiskBox[{-2.4, 0.05}, 0.16], GrayLevel[1], InsetBox[FormBox[StyleBox["\"γ\"", 13, FontFamily -> "Helvetica", StripOnInput -> False], TraditionalForm], {-2.4, 0.05}], GrayLevel[0.85], InsetBox[FormBox[StyleBox["\"single photon\"", 8, FontFamily -> "Helvetica", StripOnInput -> False], TraditionalForm], {-2.4, -0.45}]}, GrayLevel[1], InsetBox[FormBox[StyleBox["\"interior A: genuinely quantum\"", 8, FontFamily -> "Helvetica", Bold, StripOnInput -> False], TraditionalForm], {-2.4, 0.6}]}, {{GrayLevel[0.14], EdgeForm[{GrayLevel[0.5], Thickness[0.004]}], RectangleBox[{1.45, -0.8}, {3.3499999999999996, 0.8}]}, {RGBColor[0.8, 0.5, 0.18], Thickness[0.018], LineBox[{{1.95, 0.3}, {2.85, -0.25}}], LineBox[{{1.95, -0.25}, {2.85, 0.3}}], GrayLevel[0.85], InsetBox[FormBox[StyleBox["\"intensity optics\"", 8, FontFamily -> "Helvetica", StripOnInput -> False], TraditionalForm], {2.4, -0.55}]}, GrayLevel[1], InsetBox[FormBox[StyleBox["\"interior B: classical light\"", 8, FontFamily -> "Helvetica", Bold, StripOnInput -> False], TraditionalForm], {2.4, 0.6}]}, Arrowheads[0.03], GrayLevel[0.5], ArrowBox[{{-2.4, 1.5}, {-2.4, 0.85}}], ArrowBox[{{2.4, 1.5}, {2.4, 0.85}}], GrayLevel[0.18], InsetBox[FormBox[StyleBox["\"same measurement in\"", 9, FontFamily -> "Helvetica", StripOnInput -> False], TraditionalForm], {0, 1.4}], GrayLevel[0.5], ArrowBox[{{-2.4, -0.85}, {-2.4, -1.5}}], ArrowBox[{{2.4, -0.85}, {2.4, -1.5}}], GrayLevel[0.18], InsetBox[FormBox[StyleBox["\"identical click statistics out — can you tell which?\"", 10, Bold, FontFamily -> "Helvetica", StripOnInput -> False], TraditionalForm], {0, -1.75}]}, ImageSize -> 480, PlotRange -> {{-3.9, 3.9}, {-2., 1.6}}]], "Output", CellLabel -> "Out[737]=", ExpressionUUID -> "2c9a2e39-de18-4785-810a-c0218db05556"]
}, Open  ]],

Cell["\<\
The rest of the essay is the sustained attempt to tell A from B \[LongDash] \
first with statistics, then, where statistics provably cannot, with geometry. \
To do that cleanly we need the simplest possible box where A and B already \
differ at all.\
\>", "Text",ExpressionUUID->"776b3fb1-8cab-d84b-a554-85e3bd17b0c0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Stage 1 \[LongDash] The Smallest Test Case: the KCBS Pentagon", \
"Section",ExpressionUUID->"72a20591-ee8c-0e48-a4c2-a87c362207c1"],

Cell["\<\
You do not want a complicated device to study this; you want the smallest one \
where 'quantum' and 'classical' already come apart. That object is the KCBS \
pentagon: five measurements arranged so each one is ever only compared with \
its two neighbours [3]. Joining mutually-exclusive measurements by an edge \
draws exactly a five-cycle.\
\>", "Text",ExpressionUUID->"56e689ba-6ae8-c34a-acd9-162343ed4e8f"],

Cell["\<\
The exclusivity graph of the five KCBS events is the five-cycle itself:\
\>", "CodeText",ExpressionUUID->"2663e832-b2fc-7d4e-ade4-25d69a5b0355"],

Cell[CellGroupData[{

Cell["Labeled[\n Graph[CycleGraph[5],\n  VertexLabels -> Thread[Range[5] -> (Style[#, GrayLevel[0.2], Bold, FontFamily -> \"Helvetica\", 12] & /@ {\"P0\", \"P1\", \"P2\", \"P3\", \"P4\"})],\n  VertexSize -> Medium, VertexStyle -> RGBColor[0.16, 0.28, 0.46],\n  EdgeStyle -> Directive[GrayLevel[0.72], Thickness[0.008]],\n  GraphLayout -> \"CircularEmbedding\", ImageSize -> 250],\n Style[\"Each measurement excludes only its two neighbours\", FontFamily -> \"Helvetica\", 10, GrayLevel[0.35]], Bottom]", "Input", CellOpen -> False, CellLabel -> "In[738]:=", ExpressionUUID -> "7cfb722c-7d29-4383-8cdc-0515f84e0384"],

