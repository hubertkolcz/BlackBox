22], Point3DBox[{{2.416311896062463, 0.8728857226022269, 1.760303636861849}, {0.8053656680267507, 0.45867284636627903, 0.19598755815985014}, {-0.2732341586414285, 3.5448414068000123, 0.6657395614066074}, {-2.5484434054477854, 0.6430149185197879, 0.9534494004498218}, {-1.2821315093853223, -2.2159006411220146, -0.6074372347645813}, {-1.0558579507663548, -0.7448414068000124, 0.4114496766047312}, {-1.0558579507663548, -1.2719556841977855, 1.5060137520599728}, {0.8053656680267507, -2.0315585689685056, -0.9534494004498218}, {1.587989460151677, -0.8471435388274389, -1.760303636861849}}]}}, Boxed -> False, ImageSize -> 235, SphericalRegion -> True, ViewPoint -> {1.5, -2.2, 1.4}], {TagBox[GridBox[{{StyleBox["\"C7 \[TensorProduct] C7 \[TensorProduct] C5\"", Bold, 9, StripOnInput -> False]}, {StyleBox["\"9-clique witness, real 3-torus (drag to rotate)\"", 8, GrayLevel[0.45], StripOnInput -> False]}}, GridBoxAlignment -> {"Columns" -> {{Center}}}, DefaultBaseStyle -> "Column", GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Column"]}, {Bottom}]}}, AutoDelete -> False, GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, GridBoxSpacings -> {"Columns" -> {{1.4}}, "Rows" -> {{1.4}}}], "Grid"]], "Output",
