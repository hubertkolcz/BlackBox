Cell["\<\
cct_mbqc_hawking_certification.wl (built earlier in this project on this \
exact mesh) designates the adjacent pair {3k+2, 3k+3} the Hawking mode \
(exterior, the tip) and partner mode (interior); at k=0 that is qubits 2 and \
3. Z-measuring every other qubit to a fixed outcome deletes it from the graph \
(Hein et al., PRA 69, 062311 (2004)) and leaves {2,3} disconnected from the \
rest of the mesh \[LongDash] a Bell pair up to one local Hadamard:\
\>", "Text",ExpressionUUID->"29d78e97-d4cc-4479-842e-e091b8557671"],

Cell[CellGroupData[{

Cell["\<\
I2 = IdentityMatrix[2];
PX = {{0, 1}, {1, 0}}; PZ = {{1, 0}, {0, -1}}; PY = {{0, -I}, {I, 0}};
projPlus[op_] := (I2 + op)/2; projMinus[op_] := (I2 - op)/2;

(* cct_mbqc_hawking_certification.wl designates {3k+2,3k+3} the \
Hawking/partner pair; k=0 -> qubits {2,3} *)
measuredA = Complement[Range[nQ], {2, 3}];
forceGatesA = Table[QuantumOperator[projPlus[PZ], {q}], {q, measuredA}];
circA = QuantumCircuitOperator[Join[gsGates, forceGatesA]];
stA = circA[QuantumState[\"Register\", ConstantArray[2, nQ]]];
ampsA = Normal[stA[\"Amplitudes\"]];
nzA = Select[ampsA, Chop[#[[2]]] =!= 0 &];
psi23 = Table[SelectFirst[nzA, #[[1, 1]][[2 ;; 3]] == bits &][[2]], {bits, \
{{0, 0}, {0, 1}, {1, 0}, {1, 1}}}];
psi23 = psi23/Norm[psi23]\
\>", "Input",
 CellOpen->False,
 CellLabel->
  "In[803]:=",ExpressionUUID->"b1ad99a4-e30c-42f2-aff9-738dfcb85143"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", "2"], ",", 
   FractionBox["1", "2"], ",", 
   FractionBox["1", "2"], ",", 
   RowBox[{"-", 
    FractionBox["1", "2"]}]}], "}"}]], "Output",
 CellLabel->
  "Out[803]=",ExpressionUUID->"75ac7ffc-cbd6-488d-8d79-26587138955b"]
}, Open  ]],

Cell["\<\
That is exactly (|00\:27e9+|01\:27e9+|10\:27e9-|11\:27e9)/2 = \
(H\[CircleTimes]I)|\[CapitalPhi]\:207a\:27e9. The geometric lens (Stage 5) \
prices entanglement by exactly this correlation-matrix construction; turned \
on the carved pair it reads the Tsirelson-optimal violation off the exact \
singular values, not a sampled estimate:\
\>", "Text",ExpressionUUID->"3aa24bf9-63de-4677-8d4d-12de22c9163a"],

Cell[CellGroupData[{

Cell["\<\
paulis = {PX, PY, PZ};
Tmat = FullSimplify[Table[Conjugate[psi23] . (KroneckerProduct[paulis[[i]], \
paulis[[j]]] . psi23), {i, 1, 3}, {j, 1, 3}]];
sv = SingularValueList[Tmat];
Smax = FullSimplify[2 Sqrt[sv[[1]]^2 + sv[[2]]^2]];
CFval = FullSimplify[(Smax - 2)/2];
Grid[{
   {Style[\"correlation matrix T\", Bold], MatrixForm[Tmat]},
   {Style[\"singular values\", Bold], sv},
   {Style[\"CHSH optimum S\", Bold], Row[{Smax, \"  \[TildeEqual]  \", \
N[Smax]}]},
   {Style[\"contextual fraction CF\", Bold], Row[{CFval, \"  \[TildeEqual]  \
\", N[CFval]}]}
  }, Frame -> All, Alignment -> Left, Spacings -> {1.3, 1.1}, Background -> \
{None, {GrayLevel[0.93]}}]\
\>", "Input",
 CellOpen->False,
 CellLabel->
  "In[804]:=",ExpressionUUID->"7aec0352-15e4-4349-912f-aa3f27949343"],

