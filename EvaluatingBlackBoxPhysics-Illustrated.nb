        run$ = Accumulate[
            Take[phi$, n$$]]/Range[n$$]; Column[{
           Row[
            ReplaceAll[
             Take[seq$, 
              Min[n$$, 15]], {"c" -> Style["c", 
                RGBColor[0.2, 0.45, 0.85], Bold], "t" -> Style["t", 
                RGBColor[0.85, 0.55, 0.2], Bold]}], 
            Spacer[2]], 
           Show[
            ListLinePlot[run$, PlotStyle -> Directive[
               RGBColor[0.2, 0.45, 0.85], 
               Thickness[0.006]], Joined -> True, 
             PlotRange -> {{0, 120}, {0, 0.11}}, 
             AxesLabel -> {"n", "advantage / block"}, ImageSize -> 480, 
             ImagePadding -> {{55, 25}, {42, 26}}, PlotLabel -> 
             Row[{"running average after ", n$$, " blocks = ", 
                NumberForm[
                 Last[run$], {4, 4}], 
                "   (moving \[RightArrow] fixed target)"}]], 
            Graphics[{{
               RGBColor[0.85, 0.55, 0.2], Dashed, 
               Line[{{0, lim$}, {120, lim$}}]}, {
               RGBColor[0.85, 0.55, 0.2], 
               Text[
                Style[
                "fixed target: gap(cct) = 0.0699  (the n \[Rule] \[Infinity] \
limit)", 9], {58, lim$ + 0.012}]}, {
               RGBColor[0.2, 0.45, 0.85], 
               PointSize[0.02], 
               Point[{
                 Min[n$$, 120], 
                 Last[run$]}]}}]]}]], 
