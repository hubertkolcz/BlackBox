             "CircularEmbedding", ImageSize -> 220, PlotLabel -> 
             Style["classical", Bold]], 
            
            Style[$CellContext`msgC$, $CellContext`colC$, Bold, 
             11]}]; $CellContext`p$ = \
$CellContext`probsQ[$CellContext`beta$$]; $CellContext`totalQ$ = 
         Total[$CellContext`p$]; $CellContext`vcolQ$ = 
         Table[$CellContext`i -> Blend[{White, 
              RGBColor[0.2, 0.45, 0.85]}, 
             Part[$CellContext`p$, $CellContext`i + 1]], {$CellContext`i, 0, 
            4}]; $CellContext`panelQ$ = Column[{
            Graph[
             Range[0, 4], 
             MapApply[UndirectedEdge, $CellContext`edgesP], VertexLabels -> 
             "Name", VertexStyle -> $CellContext`vcolQ$, VertexSize -> 0.3, 
             GraphLayout -> "CircularEmbedding", ImageSize -> 220, PlotLabel -> 
             Style["quantum", Bold]], 
            Style["score = " <> ToString[
               NumberForm[$CellContext`totalQ$, 4]] <> 
             " (max \[Sqrt]5 at \[Beta]=0)", 
             Darker[Blue], Bold, 
             11]}]; $CellContext`ivals$ = {$CellContext`i0$$, \
$CellContext`i1$$, $CellContext`i2$$, $CellContext`i3$$, $CellContext`i4$$}; \
$CellContext`violI$ = 
         Select[$CellContext`edgesP, 
           Part[$CellContext`ivals$, Part[#, 1] + 1] + 
            Part[$CellContext`ivals$, Part[#, 2] + 1] > 
           1& ]; $CellContext`totalI$ = 
         Total[$CellContext`ivals$]; $CellContext`vcolI$ = 
         Table[$CellContext`i -> Blend[{White, 
              RGBColor[0.75, 0.2, 0.2]}, 
             Part[$CellContext`ivals$, $CellContext`i + 1]], {$CellContext`i, 
            0, 4}]; $CellContext`ecolI$ = Table[UndirectedEdge[
             Part[$CellContext`edgesP, $CellContext`k, 1], 
             Part[$CellContext`edgesP, $CellContext`k, 2]] -> If[
             MemberQ[$CellContext`violI$, 
              Part[$CellContext`edgesP, $CellContext`k]], Red, 
             Gray], {$CellContext`k, 
            5}]; {$CellContext`msgI$, $CellContext`colI$} = 
         If[Length[$CellContext`violI$] > 0, {"illegal", Red}, {
           "score = " <> ToString[
              NumberForm[$CellContext`totalI$, 3]] <> " (ceiling 5/2)", 
            If[$CellContext`totalI$ <= 2.5 + 10^(-9), 
             Darker[Green], Orange]}]; $CellContext`panelI$ = Column[{
            Graph[
             Range[0, 4], 
             MapApply[UndirectedEdge, $CellContext`edgesP], VertexLabels -> 
             "Name", VertexStyle -> $CellContext`vcolI$, 
