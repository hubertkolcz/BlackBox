             AxesLabel -> {"n", "advantage / block"}, ImageSize -> 480, 
             ImagePadding -> {{55, 25}, {42, 26}}, PlotLabel -> 
             Row[{"running average after ", $CellContext`n$$, " blocks = ", 
                NumberForm[
                 Last[$CellContext`run$], {4, 4}], 
                "   (moving \[RightArrow] fixed target)"}]], 
            Graphics[{{
               RGBColor[0.85, 0.55, 0.2], Dashed, 
               Line[{{0, $CellContext`lim$}, {120, $CellContext`lim$}}]}, {
               RGBColor[0.85, 0.55, 0.2], 
               Text[
                Style[
                "fixed target: gap(cct) = 0.0699  (the n \[Rule] \[Infinity] \
limit)", 9], {58, $CellContext`lim$ + 0.012}]}, {
               RGBColor[0.2, 0.45, 0.85], 
               PointSize[0.02], 
               Point[{
                 Min[$CellContext`n$$, 120], 
                 Last[$CellContext`run$]}]}}]]}]], 
      "Specifications" :> {{{$CellContext`n$$, 14, 
          "blocks averaged n  (1 to 120)"}, 1, 120, 1, Appearance -> 
         "Labeled"}}, "Options" :> {ControlPlacement -> Bottom}, 
      "DefaultOptions" :> {}],
     ImageSizeCache->{
      522.6000000000001, {212.70972735123848`, 218.44166077679165`}},
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    SynchronousInitialization->True,
    UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
