Cell["The same two numbers, against the bound:", "CodeText",ExpressionUUID->"dff74a29-405c-4419-be3a-6c7cb2cc38af"],

Cell[CellGroupData[{

Cell["\<\
Show[
  BarChart[{qLoad, wLoad}, ChartLabels -> {\"quantum
(p = 1/\[Sqrt]5)\", \"intensity
(p = 1/2, Wright)\"},
   ChartStyle -> {RGBColor[.2, .6, .3], RGBColor[.8, .25, .2]},
   PlotRange -> {0, 1.4}, ImageSize -> 320, ImagePadding -> {{45, 15}, {45, \
20}},
   AxesLabel -> {None, \"pentad load\"},
   PlotLabel -> \"two-copy exclusivity: worst of the 10 pentads\"],
  Graphics[{GrayLevel[0.3], Dashed, Line[{{0.3, 1}, {2.7, 1}}],
    Text[Style[\"CE bound = 1\", 9, GrayLevel[0.3]], {1.5, 1.08}]}]
  ]\
\>", "Input",
 CellOpen->False,
 CellLabel->
  "In[796]:=",ExpressionUUID->"3e0d2c63-464d-42dd-9478-3f6f1a791e16"],

