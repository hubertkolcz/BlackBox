}, Open  ]],

Cell["\<\
The rest of the essay is the sustained attempt to tell A from B \[LongDash] \
first with statistics, then, where statistics provably cannot, with geometry. \
To do that cleanly we need the simplest possible box where A and B already \
differ at all.\
\>", "Text",ExpressionUUID->"776b3fb1-8cab-d84b-a554-85e3bd17b0c0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Stage 1 \[LongDash] The Atom: the KCBS Pentagon", "Section",ExpressionUUID->"0155e221-72ef-2740-8036-f6fc468288cb"],

Cell["\<\
You do not want a complicated device to study this; you want the smallest one \
where 'quantum' and 'classical' already come apart. That object is the KCBS \
pentagon: five measurements arranged so each one is ever only compared with \
its two neighbours [3]. Joining mutually-exclusive measurements by an edge \
draws exactly a five-cycle.\
\>", "Text",ExpressionUUID->"56e689ba-6ae8-c34a-acd9-162343ed4e8f"],

Cell["\<\
The exclusivity graph of the five KCBS events is the five-cycle itself:\
\>", "CodeText",ExpressionUUID->"2663e832-b2fc-7d4e-ade4-25d69a5b0355"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"c2", " ", "=", " ", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"Pi", "/", "5"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"Pi", "/", "5"}], "]"}]}], ")"}]}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vecs", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", " ", "-", " ", "c2"}], "]"}], "*", 
         RowBox[{"Cos", "[", 
          RowBox[{"4", "*", "Pi", "*", 
           RowBox[{"(", 
            RowBox[{"i", "/", "5"}], ")"}]}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", " ", "-", " ", "c2"}], "]"}], "*", 
         RowBox[{"Sin", "[", 
          RowBox[{"4", "*", "Pi", "*", 
           RowBox[{"(", 
            RowBox[{"i", "/", "5"}], ")"}]}], "]"}]}], ",", " ", 
        RowBox[{"Sqrt", "[", "c2", "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], 
  " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stateVec", "[", "beta_", "]"}], " ", ":=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sin", "[", "beta", "]"}], ",", " ", "0", ",", " ", 
      RowBox[{"Cos", "[", "beta", "]"}]}], "}"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"probsQ", "[", "beta_", "]"}], " ", ":=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"stateVec", "[", "beta", "]"}], " ", ".", " ", 
          RowBox[{"vecs", "[", 
           RowBox[{"[", 
            RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ")"}], "^", 
        "2"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], 
  " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edgesP", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], " "}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "selC", ",", " ", "violC", ",", " ", "scoreC", ",", " ", "vcolC", ",", 
       " ", "ecolC", ",", " ", "msgC", ",", " ", "colC", ",", " ", "p", ",", 
       " ", "totalQ", ",", " ", "vcolQ", ",", " ", "ivals", ",", " ", "violI",
        ",", " ", "totalI", ",", " ", "vcolI", ",", " ", "ecolI", ",", " ", 
       "msgI", ",", " ", "colI", ",", " ", "panelC", ",", " ", "\n", "    ", 
       "panelQ", ",", " ", "panelI"}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"selC", " ", "=", " ", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "b0", ",", " ", "b1", ",", " ", "b2", ",", " ", "b3", ",", " ", 
             "b4"}], "}"}], ",", " ", "True"}], "]"}], "]"}], " ", "-", " ", 
        "1"}]}], ";", " ", "\n", "    ", 
      RowBox[{"violC", " ", "=", " ", 
       RowBox[{"Select", "[", 
        RowBox[{"edgesP", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"selC", ",", " ", 
             RowBox[{"#1", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], " ", "&&", " ", 
           RowBox[{"MemberQ", "[", 
            RowBox[{"selC", ",", " ", 
             RowBox[{"#1", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], " ", "&"}]}], " ", 
        "]"}]}], ";", " ", 
      RowBox[{"scoreC", " ", "=", " ", 
       RowBox[{"Length", "[", "selC", "]"}]}], ";", " ", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"msgC", ",", " ", "colC"}], "}"}], " ", "=", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "violC", "]"}], " ", ">", " ", "0"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"\"\<illegal\>\"", ",", " ", "Red"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"StringJoin", "[", 
            RowBox[{"\"\<score = \>\"", ",", " ", 
             RowBox[{"ToString", "[", "scoreC", "]"}], ",", 
             " ", "\"\< (ceiling 2)\>\""}], "]"}], ",", " ", "\n", "       ", 
           
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"scoreC", " ", "<=", " ", "2"}], ",", " ", 
             RowBox[{"Darker", "[", "Green", "]"}], ",", " ", "Orange"}], 
            "]"}]}], "}"}]}], "]"}]}], ";", " ", 
      RowBox[{"vcolC", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"i", " ", "->", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{"selC", ",", " ", "i"}], "]"}], ",", " ", 
            RowBox[{"Darker", "[", "Green", "]"}], ",", " ", "LightGray"}], 
           "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], ";", 
      " ", "\n", "    ", 
      RowBox[{"ecolC", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"UndirectedEdge", "[", 
           RowBox[{
            RowBox[{"edgesP", "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", "1"}], "]"}], "]"}], ",", " ", 
            RowBox[{"edgesP", "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", "2"}], "]"}], "]"}]}], "]"}], " ", "->", " ", 
          
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{"violC", ",", " ", 
              RowBox[{"edgesP", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], "]"}], ",", " ", "Red", ",", 
            " ", "Gray"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "5"}], "}"}]}], "]"}]}], ";", " ", "\n", 
      "    ", 
      RowBox[{"panelC", " ", "=", " ", 
       RowBox[{"Column", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Graph", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", "4"}], "]"}], ",", " ", 
            RowBox[{"UndirectedEdge", " ", "@@@", " ", "edgesP"}], ",", " ", 
            RowBox[{"VertexLabels", " ", "->", " ", "\"\<Name\>\""}], ",", 
            " ", 
            RowBox[{"VertexStyle", " ", "->", " ", "vcolC"}], ",", " ", 
            RowBox[{"EdgeStyle", " ", "->", " ", "ecolC"}], ",", " ", "\n", 
            "        ", 
            RowBox[{"VertexSize", " ", "->", " ", "0.3"}], ",", " ", 
            RowBox[{
            "GraphLayout", " ", "->", " ", "\"\<CircularEmbedding\>\""}], ",",
             " ", 
            RowBox[{"ImageSize", " ", "->", " ", "220"}], ",", " ", 
            RowBox[{"PlotLabel", " ", "->", " ", 
             RowBox[{"Style", "[", 
              RowBox[{"\"\<classical\>\"", ",", " ", "Bold"}], "]"}]}]}], 
           "]"}], ",", " ", "\n", "       ", 
          RowBox[{"Style", "[", 
           RowBox[{
           "msgC", ",", " ", "colC", ",", " ", "Bold", ",", " ", "11"}], 
           "]"}]}], "}"}], "]"}]}], ";", " ", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"probsQ", "[", "beta", "]"}]}], ";", " ", 
      RowBox[{"totalQ", " ", "=", " ", 
       RowBox[{"Total", "[", "p", "]"}]}], ";", " ", "\n", "    ", 
      RowBox[{"vcolQ", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"i", " ", "->", " ", 
          RowBox[{"Blend", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"White", ",", " ", 
              RowBox[{"RGBColor", "[", 
               RowBox[{"0.2", ",", " ", "0.45", ",", " ", "0.85"}], "]"}]}], 
             "}"}], ",", " ", 
            RowBox[{"p", "[", 
             RowBox[{"[", 
              RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], "]"}]}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], ";", 
      " ", "\n", "    ", 
      RowBox[{"panelQ", " ", "=", " ", 
       RowBox[{"Column", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Graph", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", "4"}], "]"}], ",", " ", 
            RowBox[{"UndirectedEdge", " ", "@@@", " ", "edgesP"}], ",", " ", 
            RowBox[{"VertexLabels", " ", "->", " ", "\"\<Name\>\""}], ",", 
            " ", 
            RowBox[{"VertexStyle", " ", "->", " ", "vcolQ"}], ",", " ", 
            RowBox[{"VertexSize", " ", "->", " ", "0.3"}], ",", " ", "\n", 
            "        ", 
            RowBox[{
            "GraphLayout", " ", "->", " ", "\"\<CircularEmbedding\>\""}], ",",
             " ", 
            RowBox[{"ImageSize", " ", "->", " ", "220"}], ",", " ", 
            RowBox[{"PlotLabel", " ", "->", " ", 
             RowBox[{"Style", "[", 
              RowBox[{"\"\<quantum\>\"", ",", " ", "Bold"}], "]"}]}]}], "]"}],
           ",", " ", "\n", "       ", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"StringJoin", "[", 
             RowBox[{"\"\<score = \>\"", ",", " ", 
              RowBox[{"ToString", "[", 
               RowBox[{"NumberForm", "[", 
                RowBox[{"totalQ", ",", " ", "4"}], "]"}], "]"}], ",", 
              " ", "\"\< (max \[Sqrt]5 at \[Beta]=0)\>\""}], "]"}], ",", " ", 
            
            RowBox[{"Darker", "[", "Blue", "]"}], ",", " ", "Bold", ",", " ", 
            "11"}], "]"}]}], "}"}], "]"}]}], ";", " ", "\n", "    ", 
      RowBox[{"ivals", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
        "i0", ",", " ", "i1", ",", " ", "i2", ",", " ", "i3", ",", " ", 
         "i4"}], "}"}]}], ";", " ", 
      RowBox[{"violI", " ", "=", " ", 
       RowBox[{"Select", "[", 
        RowBox[{"edgesP", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"ivals", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"#1", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", "1"}], "]"}], 
             "]"}], " ", "+", " ", 
            RowBox[{"ivals", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"#1", "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", "+", " ", "1"}], "]"}], 
             "]"}]}], " ", ">", " ", "1"}], " ", "&"}]}], " ", "]"}]}], ";", 
      " ", 
      RowBox[{"totalI", " ", "=", " ", 
       RowBox[{"Total", "[", "ivals", "]"}]}], ";", " ", "\n", "    ", 
      RowBox[{"vcolI", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"i", " ", "->", " ", 
          RowBox[{"Blend", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"White", ",", " ", 
              RowBox[{"RGBColor", "[", 
               RowBox[{"0.75", ",", " ", "0.2", ",", " ", "0.2"}], "]"}]}], 
             "}"}], ",", " ", 
            RowBox[{"ivals", "[", 
             RowBox[{"[", 
              RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], "]"}]}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], ";", 
      " ", "\n", "    ", 
      RowBox[{"ecolI", " ", "=", " ", 
