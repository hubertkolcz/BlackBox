        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`selC$, $CellContext`violC$, $CellContext`scoreC$, \
$CellContext`vcolC$, $CellContext`ecolC$, $CellContext`msgC$, \
$CellContext`colC$, $CellContext`p$, $CellContext`totalQ$, \
$CellContext`vcolQ$, $CellContext`ivals$, $CellContext`violI$, \
$CellContext`totalI$, $CellContext`vcolI$, $CellContext`ecolI$, \
$CellContext`msgI$, $CellContext`colI$, $CellContext`panelC$, \
$CellContext`panelQ$, $CellContext`panelI$}, $CellContext`selC$ = Flatten[
            
            Position[{$CellContext`b0$$, $CellContext`b1$$, \
$CellContext`b2$$, $CellContext`b3$$, $CellContext`b4$$}, True]] - 
          1; $CellContext`violC$ = 
         Select[{{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 0}}, And[
            MemberQ[$CellContext`selC$, 
             Part[#, 1]], 
            MemberQ[$CellContext`selC$, 
             Part[#, 2]]]& ]; $CellContext`scoreC$ = 
         Length[$CellContext`selC$]; {$CellContext`msgC$, $CellContext`colC$} = 
         If[Length[$CellContext`violC$] > 0, {"illegal", Red}, {
           "score = " <> ToString[$CellContext`scoreC$] <> " (ceiling 2)", 
            If[$CellContext`scoreC$ <= 2, 
             Darker[Green], Orange]}]; $CellContext`vcolC$ = 
         Table[$CellContext`i -> If[
             MemberQ[$CellContext`selC$, $CellContext`i], 
             Darker[Green], LightGray], {$CellContext`i, 0, 
            4}]; $CellContext`ecolC$ = Table[UndirectedEdge[
             
             Part[{{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 0}}, $CellContext`k, 
              1], 
             
             Part[{{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 0}}, $CellContext`k, 
              2]] -> If[
             MemberQ[$CellContext`violC$, 
              Part[{{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 0}}, $CellContext`k]],
              Red, Gray], {$CellContext`k, 5}]; $CellContext`panelC$ = Column[{
            Graph[
             Range[0, 4], 
             MapApply[
             UndirectedEdge, {{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 0}}], 
             VertexLabels -> "Name", VertexStyle -> $CellContext`vcolC$, 
             EdgeStyle -> $CellContext`ecolC$, VertexSize -> 0.3, GraphLayout -> 
