  FrameTicks->{{Automatic, Automatic}, {Automatic, Automatic}},
  GridLines->{None, None},
  GridLinesStyle->Directive[
    GrayLevel[0.5, 0.4]],
  ImagePadding->{{45, 15}, {45, 20}},
  ImageSize->320,
  PlotInteractivity:>True,
  PlotLabel->FormBox[
   "\"two-copy exclusivity: worst of the 10 pentads\"", TraditionalForm],
  PlotRange->{{All, All}, {0, 1.4}},
  PlotRangePadding->{{
     Scaled[0.02], 
     Scaled[0.02]}, {0, 0}},
  Ticks->{None, Automatic}]], "Output",
 CellChangeTimes->{3.992976002062441*^9},
 CellLabel->
  "Out[796]=",ExpressionUUID->"4970b160-6730-427a-9d8e-c31a0da29155"]
}, Open  ]],

Cell["\<\
25% over budget is a mathematical proof, not a judgement call: no genuine \
quantum pair of pentagons can produce that number, so a device reporting it \
is certifiably not what it claims to be. But the catch is the same one \
Stage 4 already found for a single copy: an intensity emulator tuned to the \
exact quantum fraction, p = 1/\[Sqrt]5, reproduces this test number-for-number \
\[LongDash] its worst pentad also saturates at 1, not past it \[LongDash] \
and the verdict comes back QUANTUM-CERTIFIED. Catching that particular fake \
needs the geometric lens, not another probability sum; that is the entire \
reason the instrument carries two lenses rather than one.\
\>", "Text",ExpressionUUID->"0f7762e9-b1f8-452a-9a67-264a23096994"],

Cell["\<\
There is a known general theorem, though: for large enough cycles \[LongDash] \
nine-sided or larger \[LongDash] combining independent copies this way never \
creates a bigger advantage, and the effect stays dormant. The research maps \
where composition does and does not wake it, across several concrete \
structures \[LongDash] pentagon and heptagon products, the four-pentagon \
Quad-C5 graph, the nonagon join that Stage 11 switches on, and a Paley-graph \
case that is still open:\
\>", "Text",ExpressionUUID->"0fc687b0-70a8-ac41-a9b6-870359faee69"],

Cell["\<\
The composition variants studied \[LongDash] which structures wake the \
effect, and which stay dormant:\
\>", "CodeText",ExpressionUUID->"308ed2e8-e24a-d747-bda6-a4a713c5c4fa"],

Cell[CellGroupData[{

Cell["Module[{green = RGBColor[0.24, 0.55, 0.36], amber = RGBColor[0.80, 0.50, 0.18],\n   gray = GrayLevel[0.55], navy = RGBColor[0.16, 0.28, 0.46], ink = GrayLevel[0.18], badge, rowBg},\n badge[label_, c_] := Framed[Style[label, 10, White, FontFamily -> \"Helvetica\", Bold],\n    Background -> c, RoundingRadius -> 10, FrameStyle -> None,\n    FrameMargins -> {{9, 9}, {3, 3}}];\n rowBg = Join[{navy}, Table[If[OddQ[i], White, GrayLevel[0.965]], {i, 1, 6}]];\n Grid[{\n   {Style[\"structure\", White, Bold, 11, FontFamily -> \"Helvetica\"],\n    Style[\"construction\", White, Bold, 11, FontFamily -> \"Helvetica\"],\n    Style[\"result\", White, Bold, 11, FontFamily -> \"Helvetica\"],\n    Style[\"verdict\", White, Bold, 11, FontFamily -> \"Helvetica\"]},\n   {\"C5C5\", \"two pentagon copies (co-normal)\",\n    Row[{\"ω = 5  reaches \", Sqrt[5]}], badge[\"ACTIVATES\", green]},\n   {\"C7C7C5\", \"two heptagon copies + one pentagon (co-normal)\",\n    Row[{\"9-clique, load 9\", Sqrt[5], \"/20 ≃ 1.006 > 1\"}], badge[\"ACTIVATES (mix)\", green]},\n   {\"Quad-C5\", \"four-pentagon graph (arXiv:2605.12828)\",\n    \"θ = 3.468,  Δ = 0.468\", badge[\"ACTIVATES\", green]},\n   {\"C9⋁C9⋁C9⋁C5\", \"three nonagons + one pentagon (co-normal)\",\n    \"clique ≥ 17 = 2⁴+1  (Stage 11)\", badge[\"ACTIVATES (catalysis)\", green]},\n   {\"Paley(13)⋁3\", \"Paley-13, co-normal cube (3 copies)\",\n    \"ω bracketed in [39, 46]\", badge[\"OPEN\", amber]},\n   {\"C9C9\", \"nonagon copies alone\",\n    \"never exceed the bound\", badge[\"DORMANT\", gray]}\n   },\n  Background -> {None, rowBg},\n  Frame -> None,\n  Dividers -> {None, {2 -> Directive[GrayLevel[0.8], Thin]}},\n  Alignment -> {{Left, Left, Left, Center}, Center},\n  ItemStyle -> Directive[FontFamily -> \"Helvetica\", 11, ink],\n  Spacings -> {2, 1.6},\n  ItemSize -> {Automatic, 1.7},\n  ImageSize -> 680\n  ]\n]", "Input", CellOpen -> False, CellLabel -> "In[797]:=", ExpressionUUID -> "6fb99dc3-0be2-411a-b18d-ca417e914475"],

Cell[BoxData[TagBox[GridBox[{{StyleBox["\"structure\"", GrayLevel[1], Bold, 11, FontFamily -> "Helvetica", StripOnInput -> False], StyleBox["\"construction\"", GrayLevel[1], Bold, 11, FontFamily -> "Helvetica", StripOnInput -> False], StyleBox["\"result\"", GrayLevel[1], Bold, 11, FontFamily -> "Helvetica", StripOnInput -> False], StyleBox["\"verdict\"", GrayLevel[1], Bold, 11, FontFamily -> "Helvetica", StripOnInput -> False]}, {"\"C5C5\"", "\"two pentagon copies (co-normal)\"", TemplateBox[{"\"ω = 5  reaches \"", SqrtBox["5"]}, "RowDefault"], FrameBox[StyleBox["\"ACTIVATES\"", 10, GrayLevel[1], FontFamily -> "Helvetica", Bold, StripOnInput -> False], Background -> RGBColor[0.24, 0.55, 0.36], RoundingRadius -> 10, FrameStyle -> None, FrameMargins -> {{9, 9}, {3, 3}}, StripOnInput -> False]}, {"\"C7C7C5\"", "\"two heptagon copies + one pentagon (co-normal)\"", TemplateBox[{"\"9-clique, load 9\"", SqrtBox["5"], "\"/20 ≃ 1.006 > 1\""}, "RowDefault"], FrameBox[StyleBox["\"ACTIVATES (mix)\"", 10, GrayLevel[1], FontFamily -> "Helvetica", Bold, StripOnInput -> False], Background -> RGBColor[0.24, 0.55, 0.36], RoundingRadius -> 10, FrameStyle -> None, FrameMargins -> {{9, 9}, {3, 3}}, StripOnInput -> False]}, {"\"Quad-C5\"", "\"four-pentagon graph (arXiv:2605.12828)\"", "\"θ = 3.468,  Δ = 0.468\"", FrameBox[StyleBox["\"ACTIVATES\"", 10, GrayLevel[1], FontFamily -> "Helvetica", Bold, StripOnInput -> False], Background -> RGBColor[0.24, 0.55, 0.36], RoundingRadius -> 10, FrameStyle -> None, FrameMargins -> {{9, 9}, {3, 3}}, StripOnInput -> False]}, {"\"C9⋁C9⋁C9⋁C5\"", "\"three nonagons + one pentagon (co-normal)\"", "\"clique ≥ 17 = 2⁴+1  (Stage 11)\"", FrameBox[StyleBox["\"ACTIVATES (catalysis)\"", 10, GrayLevel[1], FontFamily -> "Helvetica", Bold, StripOnInput -> False], Background -> RGBColor[0.24, 0.55, 0.36], RoundingRadius -> 10, FrameStyle -> None, FrameMargins -> {{9, 9}, {3, 3}}, StripOnInput -> False]}, {"\"Paley(13)⋁3\"", "\"Paley-13, co-normal cube (3 copies)\"", "\"ω bracketed in [39, 46]\"", FrameBox[StyleBox["\"OPEN\"", 10, GrayLevel[1], FontFamily -> "Helvetica", Bold, StripOnInput -> False], Background -> RGBColor[0.8, 0.5, 0.18], RoundingRadius -> 10, FrameStyle -> None, FrameMargins -> {{9, 9}, {3, 3}}, StripOnInput -> False]}, {"\"C9C9\"", "\"nonagon copies alone\"", "\"never exceed the bound\"", FrameBox[StyleBox["\"DORMANT\"", 10, GrayLevel[1], FontFamily -> "Helvetica", Bold, StripOnInput -> False], Background -> GrayLevel[0.55], RoundingRadius -> 10, FrameStyle -> None, FrameMargins -> {{9, 9}, {3, 3}}, StripOnInput -> False]}}, GridBoxAlignment -> {"Columns" -> {Left, Left, Left, Center}, "Rows" -> {{Center}}}, AutoDelete -> False, GridBoxBackground -> {"Columns" -> {{None}}, "Rows" -> {RGBColor[0.16, 0.28, 0.46], GrayLevel[1], GrayLevel[0.965], GrayLevel[1], GrayLevel[0.965], GrayLevel[1], GrayLevel[0.965]}}, GridBoxDividers -> {"Columns" -> {{None}}, "RowsIndexed" -> {2 -> Directive[GrayLevel[0.8], Thickness[Tiny]]}}, GridBoxFrame -> {"Columns" -> None, "Rows" -> None}, GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{1.7}}}, GridBoxItemStyle -> {"Columns" -> {{Directive[FontFamily -> "Helvetica", 11, GrayLevel[0.18]]}}, "Rows" -> {{Directive[FontFamily -> "Helvetica", 11, GrayLevel[0.18]]}}}, GridBoxSpacings -> {"Columns" -> {{2}}, "Rows" -> {{1.6}}}, ImageSize -> 680], "Grid"]], "Output", CellLabel -> "Out[797]=", ExpressionUUID -> "7c52d1fb-4cda-4987-aaed-b2d054b96082"]
}, Open  ]],

Cell["\<\
Quad-C5 is a specific literature graph, drawn as its four constituent \
pentagons in 3D. Paley(13)'s three-fold co-normal power is genuinely 3D \
too, with an explicit 39-clique (evidenced optimal, though [39,46] is not \
fully closed):\
\>", "CodeText",ExpressionUUID->"4ce915ea-8b9a-4dbb-8649-0401455acb9a"],

Cell[CellGroupData[{

Cell["Module[{quadC5, paleyC5},\n quadC5 = Module[{hub2, hub6, hub3, \
hub7, mid23, perp23, leaf0, leaf5, mid67, perp67, leaf1, leaf4, \
coordAssoc, pentagons, colors, center, bentEdgePts},\n   hub2 = {1, \
1, 1}; hub6 = {1, -1, -1}; hub3 = {-1, -1, 1}; hub7 = {-1, 1, -1};\n  \
 mid23 = (hub2 + hub3)/2; perp23 = Normalize[Cross[hub3 - hub2, {0, \
0, 1}]];\n   leaf0 = mid23 + 0.55 perp23 + 0.25 Normalize[hub2 - \
hub3];\n   leaf5 = mid23 - 0.55 perp23 - 0.25 Normalize[hub2 - \
hub3];\n   mid67 = (hub6 + hub7)/2; perp67 = Normalize[Cross[hub7 - \
hub6, {0, 0, 1}]];\n   leaf1 = mid67 + 0.55 perp67 + 0.25 \
Normalize[hub6 - hub7];\n   leaf4 = mid67 - 0.55 perp67 - 0.25 \
Normalize[hub6 - hub7];\n   coordAssoc = <|0 -> leaf0, 1 -> leaf1, 2 \
-> hub2, 3 -> hub3, 4 -> leaf4, 5 -> leaf5, 6 -> hub6, 7 -> hub7|>;\n \
  pentagons = {{0, 3, 6, 2, 5}, {0, 3, 7, 2, 5}, {1, 4, 7, 2, 6}, {1, \
4, 7, 3, 6}};\n   colors = {RGBColor[.2, .45, .85], RGBColor[.85, \
.55, .2], RGBColor[.4, .6, .3], RGBColor[.75, .25, .25]};\n   center \
= Mean[Values[coordAssoc]];\n   bentEdgePts[a_, b_, k_] := \
Module[{pa, pb, mid, dir, outward, perp, offsetMag},\n     pa = \
coordAssoc[a]; pb = coordAssoc[b]; mid = (pa + pb)/2;\n     dir = \
Normalize[pb - pa]; outward = Normalize[mid - center];\n     perp = \
Normalize[outward - (outward . dir) dir]; offsetMag = 0.16 (k - \
2.5);\n     {pa, mid + offsetMag perp, pb}];\n   \
Labeled[Graphics3D[{\n      Table[{colors[[k]], Thickness[0.009], \
Opacity[0.9],\n        Table[BSplineCurve[bentEdgePts[pentagons[[k, \
m]], pentagons[[k, Mod[m, 5] + 1]], k], SplineDegree -> 2], {m, 5}]}, \
{k, 4}],\n      {GrayLevel[0.2], Sphere[coordAssoc[#], 0.14] & /@ \
Range[0, 7]},\n      Table[Text[Style[i, 10, White, Bold], \
coordAssoc[i]], {i, 0, 7}]\n      }, Boxed -> False, ImageSize -> \
235, SphericalRegion -> True, ViewPoint -> {1.6, -2.4, 1.2}],\n    \
Column[{Style[\"Quad-C5\", Bold, 9], Style[\"4 pentagons, each edge \
shared by 2 (arXiv:2605.12828)\", 8, GrayLevel[0.45]]}, Alignment -> \
Center], Bottom]];\n paleyC5 = Module[{qr, adj13, pos3D13, verts13, \
coords13, clique13, clique39, witIdx, witCoords},\n   qr = \
DeleteDuplicates[Mod[Range[1, 12]^2, 13]];\n   adj13 = Table[If[i == \
j, 0, If[MemberQ[qr, Mod[i - j, 13]], 1, 0]], {i, 0, 12}, {j, 0, \
12}];\n   pos3D13[idx_, r_] := Module[{th}, th = 2 Pi idx/13;\n     \
r[[1]] {Cos[th[[1]]], Sin[th[[1]]], 0} + r[[2]] {0, Cos[th[[2]]], \
Sin[th[[2]]]} + r[[3]] {Cos[th[[3]]], 0, Sin[th[[3]]]}];\n   verts13 \
= Tuples[Range[0, 12], 3];\n   coords13 = pos3D13[#, {2.3, 1.5, 0.8}] \
& /@ verts13;\n   clique13 = {{0, 4}, {1, 6}, {2, 8}, {3, 10}, {4, \
12}, {5, 1}, {6, 3}, {7, 5}, {8, 7}, {9, 9}, {10, 11}, {11, 0}, {12, \
2}};\n   clique39 = Flatten[Table[Append[ab, c], {ab, clique13}, {c, \
{0, 1, 4}}], 1];\n   witIdx = Position[verts13, #][[1, 1]] & /@ \
clique39;\n   witCoords = coords13[[witIdx]];\n   \
Labeled[Graphics3D[{\n      {GrayLevel[0.7], Opacity[0.25], \
PointSize[0.005], Point[coords13]},\n      {RGBColor[.55, .35, .7], \
Opacity[0.12], Thickness[0.0012], Line[{witCoords[[#[[1]]]], \
witCoords[[#[[2]]]]}] & /@ Subsets[Range[39], {2}]},\n      \
{RGBColor[.55, .35, .7], PointSize[0.013], Point[witCoords]}\n      \
}, Boxed -> False, ImageSize -> 235, SphericalRegion -> True, \
ViewPoint -> {1.5, -2.2, 1.4}],\n    Column[{Style[\"Paley(13) \
co-normal cube\", Bold, 9], Style[\"explicit 39-clique, evidenced \
tight \[Bullet] OPEN [39,46]\", 8, GrayLevel[0.45]]}, Alignment -> \
Center], Bottom]];\n Grid[{{quadC5, paleyC5}}, Spacings -> {1.4, \
1.4}]]", "Input", CellOpen -> False, CellLabel -> "In[801]:=", 
 ExpressionUUID -> "be2835db-27ac-481f-951e-3b53a8d43a3b"],

Cell[BoxData[
