            RowBox[{"edgesP", "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", "1"}], "]"}], "]"}], ",", " ", 
            RowBox[{"edgesP", "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", "2"}], "]"}], "]"}]}], "]"}], " ", "->", " ", 
          
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
