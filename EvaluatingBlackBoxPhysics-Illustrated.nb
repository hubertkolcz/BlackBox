 TagBox[GridBox[{
    {
     StyleBox["\<\"correlation matrix T\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     TagBox[
      RowBox[{"(", "\[NoBreak]", GridBox[{
         {"0", "0", "1"},
