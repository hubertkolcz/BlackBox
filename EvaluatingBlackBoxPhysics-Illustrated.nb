            Rational[1, 2], Rational[1, 4] (-1 + 5^Rational[1, 2])}, {
           0.9510565162951535, 0.30901699437494745`}]]}}}}, ImageSize -> 200, 
     PlotRange -> 1.45, PlotRangePadding -> 0.12], 
    TagBox[
     GridBox[{{
        StyleBox[
        "\"EXCLUSIVITY ONLY\"", StripOnInput -> False, FontSize -> 10, 
         FontWeight -> Bold]}, {
        StyleBox[
        "\"Wright's one-half\"", StripOnInput -> False, LineColor -> 
