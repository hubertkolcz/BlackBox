$CellContext`panelQ$, $CellContext`panelI$}, $CellContext`selC$ = Flatten[
            
            Position[{$CellContext`b0$$, $CellContext`b1$$, \
$CellContext`b2$$, $CellContext`b3$$, $CellContext`b4$$}, True]] - 
