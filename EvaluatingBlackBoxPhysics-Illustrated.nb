caled[{1, 1/2}], ImageScaled[{1, 0.5}]]]}, {InsetBox[FormBox[StyleBox["4", Background -> GrayLevel[0, 0], {}, {FontSlant -> Italic, FontSize -> 10, FontColor -> RGBColor[0.537254, 0.537254, 0.537254]}, StripOnInput -> False], TraditionalForm], {0.28125, -4}, NCache[ImageScaled[{1, 1/2}], ImageScaled[{1, 0.5}]]]}, {InsetBox[FormBox[StyleBox["5", Background -> GrayLevel[0, 0], {}, {FontSlant -> Italic, FontSize -> 10, FontColor -> RGBColor[0.537254, 0.537254, 0.537254]}, StripOnInput -> False], TraditionalForm], {0.28125, -5}, NCache[ImageScaled[{1, 1/2}], ImageScaled[{1, 0.5}]]]}, {InsetBox[FormBox[StyleBox["6", Background -> GrayLevel[0, 0], {}, {FontSlant -> Italic, FontSize -> 10, FontColor -> RGBColor[0.537254, 0.537254, 0.537254]}, StripOnInput -> False], TraditionalForm], {0.28125, -6}, NCache[ImageScaled[{1, 1/2}], ImageScaled[{1, 0.5}]]]}, {InsetBox[FormBox[StyleBox["7", Background -> GrayLevel[0, 0], {}, {FontSlant -> Italic, FontSize -> 10, FontColor -> RGBColor[0.537254, 0.537254, 0.537254]}, StripOnInput -> False], TraditionalForm], {0.28125, -7}, NCache[ImageScaled[{1, 1/2}], ImageScaled[{1, 0.5}]]]}, {InsetBox[FormBox[StyleBox["8", Background -> GrayLevel[0, 0], {}, {FontSlant -> Italic, FontSize -> 10, FontColor -> RGBColor[0.537254, 0.537254, 0.537254]}, StripOnInput -> False], TraditionalForm], {0.28125, -8}, NCache[ImageScaled[{1, 1/2}], ImageScaled[{1, 0.5}]]]}, {InsetBox[FormBox[StyleBox["9", Background -> GrayLevel[0, 0], {}, {FontSlant -> Italic, FontSize -> 10, FontColor -> RGBColor[0.537254, 0.537254, 0.537254]}, StripOnInput -> False], TraditionalForm], {0.28125, -9}, NCache[ImageScaled[{1, 1/2}], ImageScaled[{1, 0.5}]]]}}}, {ImageSize -> 560, ImageSize -> Medium}]], "Output", CellLabel -> "Out[805]=", ExpressionUUID -> "a46cb12f-6334-49ed-9034-30c699e657fb"]
