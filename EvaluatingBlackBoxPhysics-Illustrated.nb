{-2.516850089713948, -1.6731921501180345, 1.7426969815095248}, {-0.9215747207935323, -2.9815948400929067, -0.35897349643133664}, {-1.0132099002709642, -2.9815948400929067, 0.012805041203678258}, {-2.005258630427561, -2.9815948400929067, 0.38903949771699525}, {-0.015591240197831868, -2.682444688740257, -1.4025243640281222}, {-0.10722641967526392, -2.682444688740257, -1.0307458263931073}, {-1.0992751498318605, -2.682444688740257, -0.6545113698797903}, {1.077234364587243, -1.43113329032879, -1.2344757988404846}, {0.985599185109811, -1.43113329032879, -0.8626972612054697}, {-0.006449545046785465, -1.43113329032879, -0.48646280469215275}, {2.1065489174816583, -0.39286289155540954, 0.}, {2.014913738004226, -0.39286289155540954, 0.3717785376350149}, {1.0228650078476298, -0.39286289155540954, 0.7480129941483319}, {2.8365488590023826, -0.21676617560393385, 1.2344757988404846}, {2.744913679524951, -0.21676617560393385, 1.6062543364754995}, {1.7528649493683544, -0.21676617560393385, 1.9824887929888164}}]}}, Boxed -> False, ImageSize -> 235, SphericalRegion -> True, ViewPoint -> {1.5, -2.2, 1.4}], {TagBox[GridBox[{{StyleBox["\"Paley(13) co-normal cube\"", Bold, 9, StripOnInput -> False]}, {StyleBox["\"explicit 39-clique, evidenced tight \[Bullet] OPEN [39,46]\"", 8, GrayLevel[0.45], StripOnInput -> False]}}, GridBoxAlignment -> {"Columns" -> {{Center}}}, DefaultBaseStyle -> "Column", GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Column"]}, {Bottom}]}}, AutoDelete -> False, GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, GridBoxSpacings -> {"Columns" -> {{1.4}}, "Rows" -> {{1.4}}}], "Grid"]], "Output",
