  PlotLabel->FormBox[
   "\"two pentagon blocks share a detector (orange); cis vs trans = the two \
ways to attach the next block\"", TraditionalForm],
  PlotRange->{{-1, 9}, {-1.55, 1.2}},
  PlotRangePadding->0.1]], "Output",
 CellChangeTimes->{3.99304770643091*^9},
