              GrayLevel[0.45]]}, Alignment -> Center]]], 
      "Specifications" :> {{
        tt$$, 0, 2 Pi, AnimationRunning -> True, AnimationRate -> 0.2333, 
         AnimationRepetitions -> Infinity, DefaultDuration -> 27, 
