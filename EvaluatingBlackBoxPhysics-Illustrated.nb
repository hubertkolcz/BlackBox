      Module[{$CellContext`choice$, $CellContext`edges$, \
$CellContext`globals$, $CellContext`doesGlue$, $CellContext`glues$, \
$CellContext`ecol$, $CellContext`msg$, $CellContext`col$}, \
$CellContext`edges$ = {{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 
          0}}; $CellContext`globals$ = 
         Tuples[{0, 1}, 5]; $CellContext`choice$ = 
         ReplaceAll[{$CellContext`o1$$, $CellContext`o2$$, $CellContext`o3$$, \
$CellContext`o4$$, $CellContext`o5$$}, {
           "(0,0)" -> {0, 0}, "(0,1)" -> {0, 1}, 
            "(1,0)" -> {1, 0}}]; $CellContext`doesGlue$[
           Pattern[$CellContext`ch$, 
            Blank[]]] := AnyTrue[$CellContext`globals$, 
           Function[$CellContext`g$, 
            AllTrue[
             Range[5], And[
             Part[$CellContext`g$, Part[$CellContext`edges$, #, 1] + 1] == 
              Part[$CellContext`ch$, #, 1], 
              Part[$CellContext`g$, Part[$CellContext`edges$, #, 2] + 1] == 
              Part[$CellContext`ch$, #, 
                2]]& ]]]; $CellContext`glues$ = \
$CellContext`doesGlue$[$CellContext`choice$]; $CellContext`ecol$ = 
         Table[UndirectedEdge[
             Part[$CellContext`edges$, $CellContext`k, 1], 
             Part[$CellContext`edges$, $CellContext`k, 2]] -> Directive[Thick, 
             If[$CellContext`glues$, 
              Darker[Green], Red]], {$CellContext`k, 
            5}]; {$CellContext`msg$, $CellContext`col$} = 
         If[$CellContext`glues$, {
           "glues: a single global 5-bit assignment reproduces all 5 local \
choices at once (noncontextual)", 
            Darker[Green]}, {
           "does NOT glue: no global assignment is consistent with all 5 \
local choices at once (a genuine sheaf obstruction)", Red}]; Column[{
           Graph[
            Range[0, 4], 
            MapApply[UndirectedEdge, $CellContext`edges$], VertexLabels -> 
            "Name", VertexSize -> 0.3, EdgeStyle -> $CellContext`ecol$, 
            GraphLayout -> "CircularEmbedding", ImageSize -> 260, EdgeLabels -> 
