Cell["cct_mbqc_hawking_certification.wl (built earlier in this project on this exact mesh) designates the adjacent pair {3k+2, 3k+3} the Hawking mode (exterior, the tip) and partner mode (interior); at k=0 that is qubits 2 and 3. Z-measuring every other qubit to a fixed outcome deletes it from the graph (Hein et al., PRA 69, 062311 (2004)) and leaves {2,3} disconnected from the rest of the mesh — a Bell pair up to one local Hadamard:", "Text", ExpressionUUID -> "29d78e97-d4cc-4479-842e-e091b8557671"],

Cell[CellGroupData[{

Cell["I2 = IdentityMatrix[2];\nPX = {{0, 1}, {1, 0}}; PZ = {{1, 0}, {0, -1}}; PY = {{0, -I}, {I, 0}};\nprojPlus[op_] := (I2 + op)/2; projMinus[op_] := (I2 - op)/2;\n\n(* cct_mbqc_hawking_certification.wl designates {3k+2,3k+3} the Hawking/partner pair; k=0 -> qubits {2,3} *)\nmeasuredA = Complement[Range[nQ], {2, 3}];\nforceGatesA = Table[QuantumOperator[projPlus[PZ], {q}], {q, measuredA}];\ncircA = QuantumCircuitOperator[Join[gsGates, forceGatesA]];\nstA = circA[QuantumState[\"Register\", ConstantArray[2, nQ]]];\nampsA = Normal[stA[\"Amplitudes\"]];\nnzA = Select[ampsA, Chop[#[[2]]] =!= 0 &];\npsi23 = Table[SelectFirst[nzA, #[[1, 1]][[2 ;; 3]] == bits &][[2]], {bits, {{0, 0}, {0, 1}, {1, 0}, {1, 1}}}];\npsi23 = psi23/Norm[psi23]", "Input", CellOpen -> False, CellLabel -> "In[803]:=", ExpressionUUID -> "b1ad99a4-e30c-42f2-aff9-738dfcb85143"],

Cell[BoxData[RowBox[{"{", RowBox[{FractionBox["1", "2"], ",", FractionBox["1", "2"], ",", FractionBox["1", "2"], ",", RowBox[{"-", FractionBox["1", "2"]}]}], "}"}]], "Output", CellLabel -> "Out[803]=", ExpressionUUID -> "75ac7ffc-cbd6-488d-8d79-26587138955b"]
}, Open  ]],

Cell["That is exactly (|00〉+|01〉+|10〉-|11〉)/2 = (H⊗I)|Φ⁺〉. The geometric lens (Stage 5) prices entanglement by exactly this correlation-matrix construction; turned on the carved pair it reads the Tsirelson-optimal violation off the exact singular values, not a sampled estimate:", "Text", ExpressionUUID -> "3aa24bf9-63de-4677-8d4d-12de22c9163a"],

Cell[CellGroupData[{

Cell["paulis = {PX, PY, PZ};\nTmat = FullSimplify[Table[Conjugate[psi23] . (KroneckerProduct[paulis[[i]], paulis[[j]]] . psi23), {i, 1, 3}, {j, 1, 3}]];\nsv = SingularValueList[Tmat];\nSmax = FullSimplify[2 Sqrt[sv[[1]]^2 + sv[[2]]^2]];\nCFval = FullSimplify[(Smax - 2)/2];\nGrid[{\n   {Style[\"correlation matrix T\", Bold], MatrixForm[Tmat]},\n   {Style[\"singular values\", Bold], sv},\n   {Style[\"CHSH optimum S\", Bold], Row[{Smax, \"  ≃  \", N[Smax]}]},\n   {Style[\"contextual fraction CF\", Bold], Row[{CFval, \"  ≃  \", N[CFval]}]}\n  }, Frame -> All, Alignment -> Left, Spacings -> {1.3, 1.1}, Background -> {None, {GrayLevel[0.93]}}]", "Input", CellOpen -> False, CellLabel -> "In[804]:=", ExpressionUUID -> "7aec0352-15e4-4349-912f-aa3f27949343"],

Cell[BoxData[TagBox[GridBox[{{StyleBox["\"correlation matrix T\"", Bold, StripOnInput -> False], TagBox[RowBox[{"(", "⁠", GridBox[{{"0", "0", "1"}, {"0", "1", "0"}, {"1", "0", "0"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "⁠", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]}, {StyleBox["\"singular values\"", Bold, StripOnInput -> False], RowBox[{"{", RowBox[{"1", ",", "1", ",", "1"}], "}"}]}, {StyleBox["\"CHSH optimum S\"", Bold, StripOnInput -> False], TemplateBox[{RowBox[{"2", " ", SqrtBox["2"]}], "\"  ≃  \"", "2.8284271247461903`"}, "RowDefault"]}, {StyleBox["\"contextual fraction CF\"", Bold, StripOnInput -> False], TemplateBox[{RowBox[{RowBox[{"-", "1"}], "+", SqrtBox["2"]}], "\"  ≃  \"", "0.41421356237309515`"}, "RowDefault"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, GridBoxBackground -> {"Columns" -> {{None}}, "Rows" -> {GrayLevel[0.93]}}, GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, GridBoxSpacings -> {"Columns" -> {{1.3}}, "Rows" -> {{1.1}}}], "Grid"]], "Output", CellLabel -> "Out[804]=", ExpressionUUID -> "a10f76ea-2fe0-4b2d-8175-b4933a2b88ad"]
}, Open  ]],

Cell["S = 2√2 and CF = √2-1 exactly — the same two numbers cct_mbqc_hawking_certification.wl pins as its ground truth for an ideal carved pair. The mesh really does carry a genuine analogue-Hawking correlation, and the geometric lens really does certify it, live, from this notebook's own kernel.", "Text", ExpressionUUID -> "e7985efd-96c8-4b31-adfd-ccf1bee07307"],

Cell["Carving the computation instead: Z-measuring the other six qubits leaves survivors {1,2,3}, the induced path of Stage 7, as a GHZ triple after one fixed local Clifford. That correction (H conjugates X into Z and Y into -Y) can be folded directly into which operator gets measured, rather than applied as a separate gate — so the circuit below performs the entire Anders-Browne OR(a,b) protocol as a single pass of genuine quantum measurements, with the byproduct correction left as classical post-processing of the outcomes:", "Text", ExpressionUUID -> "7bdbf50b-d0a5-443d-9f49-2127df18b71c"],

Cell[CellGroupData[{

Cell["measNbr = Table[Select[nbrsOf[edges1, s], # > 3 &], {s, 1, 3}];\nzMeasGates = Table[QuantumMeasurementOperator[{projPlus[PZ], projMinus[PZ]}, {q}], {q, 4, nQ}];\nghzSetting[t_] := If[t == 1, PY, PX];   (* GHZ-frame operator for qubit 2 *)\nomg[t_] := If[t == 1, -PY, PZ];         (* H-conjugated operator for qubits 1,3: H.X.H=Z, H.Y.H=-Y *)\norCircuit[a_, b_] := Module[{c = Mod[a + b, 2]},\n  QuantumCircuitOperator[Join[gsGates, zMeasGates, {\n     QuantumMeasurementOperator[{projPlus[omg[a]], projMinus[omg[a]]}, {1}],\n     QuantumMeasurementOperator[{projPlus[ghzSetting[b]], projMinus[ghzSetting[b]]}, {2}],\n     QuantumMeasurementOperator[{projPlus[omg[c]], projMinus[omg[c]]}, {3}]}]]];\nShow[orCircuit[1, 0][\"Diagram\"], ImageSize -> 560]", "Input", CellOpen -> False, CellLabel -> "In[805]:=", ExpressionUUID -> "a660b556-f277-4db3-8db5-f74ed94723e5"],

Cell[BoxData[GraphicsBox[{{{Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{1.375, -7}, {1.625, -7}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{1.375, -8}, {1.625, -8}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{1.375, -1}, {2.625, -1}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{2.375, -8}, {2.625, -8}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{3.375, -1}, {3.625, -1}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{1.375, -2}, {3.625, -2}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{4.375, -2}, {4.625, -2}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{1.375, -3}, {4.625, -3}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{5.375, -3}, {5.625, -3}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{2.375, -7}, {5.625, -7}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{4.375, -1}, {6.625, -1}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{1.375, -4}, {6.625, -4}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{7.375, -4}, {7.625, -4}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{1.375, -5}, {7.625, -5}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{8.375, -5}, {8.625, -5}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{1.375, -6}, {8.625, -6}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{5.375, -2}, {9.625, -2}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{9.375, -6}, {9.625, -6}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{8.375, -4}, {10.625, -4}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{6.375, -7}, {10.625, -7}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{3.375, -8}, {3.625, -8}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{1.375, -9}, {3.625, -9}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickness[1], Opacity[0.3]], LineBox[{{9.375, -5}, {11.625, -5}}]}}, {Directive[CapForm[None], RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]], {Directive[AbsoluteThickn