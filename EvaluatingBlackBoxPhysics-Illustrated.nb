     FontSize->12,
     FontColor->RGBColor[0.85, 0.45, 0.2]], {2.5, 0.15}], InsetBox[
    StyleBox["\<\"exclusivity ceiling (no-signaling)\"\>",
     StripOnInput->False,
     LineColor->GrayLevel[0.5],
     FrontFaceColor->GrayLevel[0.5],
     BackFaceColor->GrayLevel[0.5],
     GraphicsColor->GrayLevel[0.5],
     FontSize->8,
     FontColor->GrayLevel[0.5]], {2.5, -0.15}], InsetBox[
    StyleBox["\<\"quantum zone\"\>",
     StripOnInput->False,
     LineColor->RGBColor[0.2, 0.45, 0.85],
     FrontFaceColor->RGBColor[0.2, 0.45, 0.85],
     BackFaceColor->RGBColor[0.2, 0.45, 0.85],
     GraphicsColor->RGBColor[0.2, 0.45, 0.85],
     FontSize->9,
     FontColor->RGBColor[0.2, 0.45, 0.85]], {2.118033988749895, 0.3}], 
   InsetBox[
    StyleBox["\<\"'meta-optics' overhang\"\>",
     StripOnInput->False,
     LineColor->RGBColor[0.85, 0.45, 0.2],
     FrontFaceColor->RGBColor[0.85, 0.45, 0.2],
     BackFaceColor->RGBColor[0.85, 0.45, 0.2],
