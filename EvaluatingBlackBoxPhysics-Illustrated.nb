               Part[$CellContext`witCoords$, 
                Part[#, 2]]}]& , 
             Select[$CellContext`edgesAll$, Not[
               $CellContext`edgeActive$[#]]& ]]}, {
            RGBColor[0.2, 0.45, 0.85], 
            Opacity[0.75], 
            Thickness[0.006], 
            Map[Line[{
