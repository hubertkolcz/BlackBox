          RowBox[{
           RowBox[{"StringJoin", "[", 
            RowBox[{"\"\<score = \>\"", ",", " ", 
             RowBox[{"ToString", "[", 
              RowBox[{"NumberForm", "[", 
               RowBox[{"totalI", ",", " ", "3"}], "]"}], "]"}], ",", 
