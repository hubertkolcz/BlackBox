Cell["\<\
Gluing a ring one way ('trans') keeps a substantial gap open at essentially \
every size; gluing it the opposite way ('cis') collapses the gap to exactly \
zero at almost every size \[LongDash] the composed graph becomes as good for \
a classical hidden-variable model as for a quantum one. Same block count, \
opposite fate:\
\>", "Text",ExpressionUUID->"cf3a7371-c9d0-064f-a76b-29cdd81ca994"],

Cell["\<\
Same number of pentagons, opposite outcome \[LongDash] orientation decides \
the gap:\
\>", "CodeText",ExpressionUUID->"58a2b005-5573-b845-ad1b-0a860eb7e19f"],

Cell[CellGroupData[{

Cell["\<\
nRange = Range[3, 17];
transGap = {0., 0.5014, 0.7702, 0.0979, 0.6037, 1.0028, 0.3097, 0.6792, \
1.1336, 0.5041, 0.8336, 1.2191, 0.6484, 1.0058, 1.3519};
cisGap = {0., 0., 0.2361, 0., 0.3177, 0., 0.3601, 0., 0.3863, 0., 0.4042, 0., \
0.4171, 0., 0.4270};
ListLinePlot[{Transpose[{nRange, transGap}], Transpose[{nRange, cisGap}]},
 PlotMarkers -> Automatic, PlotLegends -> {\"trans-ring\", \"cis-ring\"},
 AxesLabel -> {\"N (pentagons in the ring)\", \"quantum advantage \[Theta]-\
\[Alpha]\"},
 PlotRange -> {{2.5, 17.5}, {-0.1, 1.5}}, ImageSize -> 480, ImagePadding -> \
{{45, 15}, {40, 28}},
 PlotLabel -> \"trans grows with size (extensive); cis stays bounded \
\[LongDash] orientation, not count, decides\"]\
\>", "Input",
