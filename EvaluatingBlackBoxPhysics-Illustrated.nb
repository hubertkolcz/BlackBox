8], {2, 2.3}],
   RGBColor[.85, .45, .2], Arrow[{{-0.1, 1.8}, {-0.9, 0.5}}], Arrow[{{3.9, \
1.8}, {3.1, 0.5}}],
   Text[Style[\"correlation lens: CF density\", 8], {-0.7, 0.25}],
   RGBColor[.2, .45, .85], Arrow[{{0.1, 1.8}, {0.9, 0.5}}], Arrow[{{4.1, \
1.8}, {4.9, 0.5}}],
   Text[Style[\"geometric lens: DLA\", 8], {4.7, 0.25}],
   Red, Text[Style[\"\[Times]  the square does not commute: the two lenses \
decorrelate under gluing (LP-002)\", 9, Bold], {2, -0.7}]
   }, ImageSize -> 540, PlotRange -> {{-2.4, 6.4}, {-1.1, 2.7}}]\
\>", "Input",
