Cell["\<\
This 'ACTIVATES' verdict is not only a graph fact. The project's own \
black-box certifier wires exactly this construction \[LongDash] the \
two-copy exclusivity graph above, 535 maximal cliques, ten of them pentads \
\[LongDash] into a real pass/fail test: sum the joint probability over each \
pentad, and flag the device the moment any sum passes 1.\
\>", "Text",ExpressionUUID->"8aa644d7-aa72-4484-bb8e-91ed5347d94c"],

Cell["\<\
Run live, on two tables: the quantum-optimal one, and the one a classical \
light-splitter reports when it mistakes intensity fractions for click \
probabilities (Wright's table):\
\>", "CodeText",ExpressionUUID->"3167a827-cd30-47ca-ab68-235a4d606008"],

Cell[CellGroupData[{

Cell["verts = Tuples[Range[1, 5], 2];\nadj = Function[{u, w}, Or @@ MapThread[MemberQ[{1, 4}, Mod[#1 - #2, 5]] &, {u, w}]];\nepairs = Select[Subsets[verts, {2}], adj[#[[1]], #[[2]]] &];\ncliques = FindClique[Graph[verts, UndirectedEdge @@@ epairs], Infinity, All];\npentads = Select[cliques, Length[#] == 5 &];\nloadOf[p_] := Max[Table[Total[(p[[#[[1]]]] p[[#[[2]]]]) & /@ K], {K, pentads}]];\n{qLoad, wLoad} = {loadOf[ConstantArray[1/Sqrt[5], 5]], loadOf[ConstantArray[1/2, 5]]};\nModule[{green = RGBColor[0.24, 0.55, 0.36], red = RGBColor[0.75, 0.30, 0.24],\n   navy = RGBColor[0.16, 0.28, 0.46], ink = GrayLevel[0.18], badge, g},\n badge[label_, c_] := Framed[Style[label, 10, White, FontFamily -> \"Helvetica\", Bold],\n    Background -> c, RoundingRadius -> 10, FrameStyle -> None, FrameMargins -> {{9, 9}, {3, 3}}];\n g = Grid[{\n    {Style[\"table\", White, Bold, 11, FontFamily -> \"Helvetica\"],\n     Style[\"per-event p\", White, Bold, 11, FontFamily -> \"Helvetica\"],\n     Style[\"worst pentad load\", White, Bold, 11, FontFamily -> \"Helvetica\"],\n     Style[\"verdict\", White, Bold, 11, FontFamily -> \"Helvetica\"]},\n    {\"quantum-optimal\", 1/Sqrt[5], qLoad, badge[\"safe (saturates)\", green]},\n    {\"intensity fractions (Wright)\", 1/2, wLoad, badge[\"EMULATION-SUSPECT\", red]}\n    },\n   Background -> {None, {navy, White, GrayLevel[0.965]}},\n   Frame -> None,\n   Dividers -> {None, {2 -> Directive[GrayLevel[0.8], Thin]}},\n   Alignment -> {{Left, Center, Center, Center}, Center},\n   ItemStyle -> Directive[FontFamily -> \"Helvetica\", 11, ink],\n   Spacings -> {2.2, 2}, ItemSize -> {Automatic, 2.2}];\n Framed[g, FrameStyle -> None, FrameMargins -> {{0, 0}, {8, 0}}, Background -> White]\n]", "Input", CellOpen -> False, CellLabel -> "In[796]:=", ExpressionUUID -> "a2303528-bf93-4227-a6ed-8a2636fbab75"],

Cell[BoxData[FrameBox[TagBox[GridBox[{{StyleBox["\"table\"", GrayLevel[1], Bold, 11, FontFamily -> "Helvetica", StripOnInput -> False], StyleBox["\"per-event p\"", GrayLevel[1], Bold, 11, FontFamily -> "Helvetica", StripOnInput -> False], StyleBox["\"worst pentad load\"", GrayLevel[1], Bold, 11, FontFamily -> "Helvetica", StripOnInput -> False], StyleBox["\"verdict\"", GrayLevel[1], Bold, 11, FontFamily -> "Helvetica", StripOnInput -> False]}, {"\"quantum-optimal\"", FractionBox["1", SqrtBox["5"]], "1", FrameBox[StyleBox["\"safe (saturates)\"", 10, GrayLevel[1], FontFamily -> "Helvetica", Bold, StripOnInput -> False], Background -> RGBColor[0.24, 0.55, 0.36], RoundingRadius -> 10, FrameStyle -> None, FrameMargins -> {{9, 9}, {3, 3}}, StripOnInput -> False]}, {"\"intensity fractions (Wright)\"", FractionBox["1", "2"], FractionBox["5", "4"], FrameBox[StyleBox["\"EMULATION-SUSPECT\"", 10, GrayLevel[1], FontFamily -> "Helvetica", Bold, StripOnInput -> False], Background -> RGBColor[0.75, 0.3, 0.24], RoundingRadius -> 10, FrameStyle -> None, FrameMargins -> {{9, 9}, {3, 3}}, StripOnInput -> False]}}, GridBoxAlignment -> {"Columns" -> {Left, Center, Center, Center}, "Rows" -> {{Center}}}, AutoDelete -> False, GridBoxBackground -> {"Columns" -> {{None}}, "Rows" -> {RGBColor[0.16, 0.28, 0.46], GrayLevel[1], GrayLevel[0.965]}}, GridBoxDividers -> {"Columns" -> {{None}}, "RowsIndexed" -> {2 -> Directive[GrayLevel[0.8], Thickness[Tiny]]}}, GridBoxFrame -> {"Columns" -> None, "Rows" -> None}, GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{2.2}}}, GridBoxItemStyle -> {"Columns" -> {{Directive[FontFamily -> "Helvetica", 11, GrayLevel[0.18]]}}, "Rows" -> {{Directive[FontFamily -> "Helvetica", 11, GrayLevel[0.18]]}}}, GridBoxSpacings -> {"Columns" -> {{2.2}}, "Rows" -> {{2}}}], "Grid"], FrameStyle -> None, FrameMargins -> {{0, 0}, {8, 0}}, Background -> GrayLevel[1], StripOnInput -> False]], "Output", CellLabel -> "Out[796]=", ExpressionUUID -> "68b266e5-5aec-4800-9959-36ea9e9b3778"]
}, Open  ]],

Cell["The same two numbers, against the bound:", \
"CodeText",ExpressionUUID->"dff74a29-405c-4419-be3a-6c7cb2cc38af"],

Cell[CellGroupData[{

Cell["Show[\n  BarChart[{qLoad, wLoad}, ChartLabels -> {\"quantum\n(p \
= 1/\[Sqrt]5)\", \"intensity\n(p = 1/2, Wright)\"},\n   ChartStyle -> \
{RGBColor[.2, .6, .3], RGBColor[.8, .25, .2]},\n   PlotRange -> {0, \
1.4}, ImageSize -> 320, ImagePadding -> {{45, 15}, {45, 20}},\n   \
AxesLabel -> {None, \"pentad load\"},\n   PlotLabel -> \"two-copy \
exclusivity: worst of the 10 pentads\"],\n  Graphics[{GrayLevel[0.3], \
Dashed, Line[{{0.3, 1}, {2.7, 1}}],\n    Text[Style[\"CE bound = 1\", \
9, GrayLevel[0.3]], {1.5, 1.08}]}]\n  ]", "Input", CellOpen -> False, 
 CellLabel -> "In[796]:=", ExpressionUUID -> 
  "3e0d2c63-464d-42dd-9478-3f6f1a791e16"],

