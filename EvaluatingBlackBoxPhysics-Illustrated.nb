               Cos[
                Part[$CellContext`th, 3]], 0, 
               Sin[
                Part[$CellContext`th, 3]]}]; $CellContext`verts9$ = Tuples[
           Range[0, 8], 3]; $CellContext`coords9$ = 
         Map[$CellContext`pos3D9$[#, {2.3, 1.5, 
            0.8}]& , $CellContext`verts9$]; $CellContext`witness17$ = {{0, 0, 
          0, 0}, {2, 4, 4, 1}, {4, 3, 4, 1}, {6, 7, 3, 1}, {6, 7, 8, 2}, {7, 
