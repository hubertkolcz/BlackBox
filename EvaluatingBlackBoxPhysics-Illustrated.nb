Cell["\<\
The same ruler, live \[LongDash] toggle the classical yes/no answers, tilt \
the quantum state \[Beta], and slide the five independent intensities, and \
watch each vertex's colour track its value against its own ceiling (2, \
\[Sqrt]5, 5/2). Interactive board reused from the project's companion \
notebook TheBlackBoxGame.nb:\
\>", "CodeText",ExpressionUUID->"9f6632a8-fcc1-734a-9e5e-f1d65bd28594"],

Cell["\<\
With[{c2 = Cos[Pi/5]/(1 + Cos[Pi/5])},
With[{vecs = Table[{Sqrt[1 - Cos[Pi/5]/(1 + Cos[Pi/5])] Cos[4 Pi i/5], Sqrt[1 \
- Cos[Pi/5]/(1 + Cos[Pi/5])] Sin[4 Pi i/5], Sqrt[Cos[Pi/5]/(1 + Cos[Pi/5])]}, \
{i, 0, 4}]},
With[{stateVec = Function[beta, {Sin[beta], 0, Cos[beta]}]},
With[{probsQ = Function[beta, Table[N[({Sin[beta], 0, Cos[beta]} . vecs[[i + \
1]])^2], {i, 0, 4}]]},
With[{edgesP = {{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 0}}},

Manipulate[
 Module[{selC, violC, scoreC, vcolC, ecolC, msgC, colC,
   p, totalQ, vcolQ,
   ivals, violI, totalI, vcolI, ecolI, msgI, colI,
   panelC, panelQ, panelI},

   selC = Flatten[Position[{b0, b1, b2, b3, b4}, True]] - 1;
   violC = Select[edgesP, MemberQ[selC, #[[1]]] && MemberQ[selC, #[[2]]] &];
   scoreC = Length[selC];
   {msgC, colC} = If[Length[violC] > 0,
     {\"illegal\", Red},
     {\"score = \" <> ToString[scoreC] <> \" (ceiling 2)\", If[scoreC <= 2, \
Darker[Green], Orange]}];
   vcolC = Table[i -> If[MemberQ[selC, i], Darker[Green], LightGray], {i, 0, \
4}];
   ecolC = Table[UndirectedEdge[edgesP[[k, 1]], edgesP[[k, 2]]] ->
       If[MemberQ[violC, edgesP[[k]]], Red, Gray], {k, 5}];
   panelC = Column[{
      Graph[Range[0, 4], UndirectedEdge @@@ edgesP, VertexLabels -> \"Name\",
       VertexStyle -> vcolC, EdgeStyle -> ecolC, VertexSize -> 0.3,
       GraphLayout -> \"CircularEmbedding\", ImageSize -> 220,
       PlotLabel -> Style[\"classical\", Bold]],
      Style[msgC, colC, Bold, 11]}];

   p = probsQ[beta]; totalQ = Total[p];
   vcolQ = Table[i -> Blend[{White, RGBColor[0.2, 0.45, 0.85]}, p[[i + 1]]], \
{i, 0, 4}];
   panelQ = Column[{
      Graph[Range[0, 4], UndirectedEdge @@@ edgesP, VertexLabels -> \"Name\",
       VertexStyle -> vcolQ, VertexSize -> 0.3, GraphLayout -> \
\"CircularEmbedding\",
       ImageSize -> 220, PlotLabel -> Style[\"quantum\", Bold]],
      Style[\"score = \" <> ToString[NumberForm[totalQ, 4]] <> \" (max \
\\[Sqrt]5 at \\[Beta]=0)\",
       Darker[Blue], Bold, 11]}];

   ivals = {i0, i1, i2, i3, i4};
   violI = Select[edgesP, (ivals[[#[[1]] + 1]] + ivals[[#[[2]] + 1]] > 1) &];
   totalI = Total[ivals];
   vcolI = Table[i -> Blend[{White, RGBColor[0.75, 0.2, 0.2]}, ivals[[i + \
1]]], {i, 0, 4}];
   ecolI = Table[UndirectedEdge[edgesP[[k, 1]], edgesP[[k, 2]]] ->
       If[MemberQ[violI, edgesP[[k]]], Red, Gray], {k, 5}];
   {msgI, colI} = If[Length[violI] > 0,
     {\"illegal\", Red},
     {\"score = \" <> ToString[NumberForm[totalI, 3]] <> \" (ceiling 5/2)\",
      If[totalI <= 2.5 + 10^-9, Darker[Green], Orange]}];
   panelI = Column[{
      Graph[Range[0, 4], UndirectedEdge @@@ edgesP, VertexLabels -> \"Name\",
       VertexStyle -> vcolI, EdgeStyle -> ecolI, VertexSize -> 0.3,
       GraphLayout -> \"CircularEmbedding\", ImageSize -> 220,
       PlotLabel -> Style[\"classical light (non-classical)\", Bold]],
      Style[msgI, colI, Bold, 11]}];

   Row[{panelC, panelQ, panelI}, Spacer[16]]
   ],
 Delimiter,
 Style[\"classical: pick yes/no answers\", Bold],
 {{b0, False, \"v0\"}, {False, True}}, {{b1, False, \"v1\"}, {False, True}},
 {{b2, False, \"v2\"}, {False, True}}, {{b3, False, \"v3\"}, {False, True}},
 {{b4, False, \"v4\"}, {False, True}},
 Delimiter,
 Style[\"quantum: tilt the state\", Bold],
 {{beta, 0, \"state tilt \\[Beta]\"}, 0, 1.2},
 Delimiter,
 Style[\"classical light: set 5 independent intensities\", Bold],
 {{i0, 0.5, \"i0\"}, 0, 1}, {{i1, 0.5, \"i1\"}, 0, 1}, {{i2, 0.5, \"i2\"}, 0, \
1},
 {{i3, 0.5, \"i3\"}, 0, 1}, {{i4, 0.5, \"i4\"}, 0, 1}
 ]

]]]]]\
\>", "Input",
 CellOpen->False,ExpressionUUID->"3f2339fa-d012-5a48-9aa9-c5490617c084"],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`b0$$ = False, $CellContext`b1$$ = 
    False, $CellContext`b2$$ = False, $CellContext`b3$$ = 
    False, $CellContext`b4$$ = False, $CellContext`beta$$ = 
    0, $CellContext`i0$$ = 0.5, $CellContext`i1$$ = 0.5, $CellContext`i2$$ = 
    0.5, $CellContext`i3$$ = 0.5, $CellContext`i4$$ = 0.5, Typeset`show$$ = 
    True, Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{
      Hold[
       Style["classical: pick yes/no answers", Bold]], 
      Manipulate`Dump`ThisIsNotAControl, ControlType -> None}, {{
       Hold[$CellContext`b0$$], False, "v0"}, {False, True}, ControlType -> 
      Checkbox}, {{
       Hold[$CellContext`b1$$], False, "v1"}, {False, True}, ControlType -> 
      Checkbox}, {{
       Hold[$CellContext`b2$$], False, "v2"}, {False, True}, ControlType -> 
      Checkbox}, {{
       Hold[$CellContext`b3$$], False, "v3"}, {False, True}, ControlType -> 
      Checkbox}, {{
       Hold[$CellContext`b4$$], False, "v4"}, {False, True}, ControlType -> 
      Checkbox}, {
      Hold[
       Style["quantum: tilt the state", Bold]], 
      Manipulate`Dump`ThisIsNotAControl, ControlType -> None}, {{
       Hold[$CellContext`beta$$], 0, "state tilt \[Beta]"}, 0, 1.2, 
      ControlType -> Manipulator}, {
      Hold[
       Style["classical light: set 5 independent intensities", Bold]], 
      Manipulate`Dump`ThisIsNotAControl, ControlType -> None}, {{
       Hold[$CellContext`i0$$], 0.5, "i0"}, 0, 1, ControlType -> 
      Manipulator}, {{
       Hold[$CellContext`i1$$], 0.5, "i1"}, 0, 1, ControlType -> 
      Manipulator}, {{
       Hold[$CellContext`i2$$], 0.5, "i2"}, 0, 1, ControlType -> 
      Manipulator}, {{
       Hold[$CellContext`i3$$], 0.5, "i3"}, 0, 1, ControlType -> 
      Manipulator}, {{
       Hold[$CellContext`i4$$], 0.5, "i4"}, 0, 1, ControlType -> 
      Manipulator}}, Typeset`size$$ = Automatic, Typeset`update$$ = 0, 
    Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`b0$$ = False, $CellContext`b1$$ = 
        False, $CellContext`b2$$ = False, $CellContext`b3$$ = 
        False, $CellContext`b4$$ = False, $CellContext`beta$$ = 
        0, $CellContext`i0$$ = 0.5, $CellContext`i1$$ = 
        0.5, $CellContext`i2$$ = 0.5, $CellContext`i3$$ = 
        0.5, $CellContext`i4$$ = 0.5}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`selC$, $CellContext`violC$, $CellContext`scoreC$, \
$CellContext`vcolC$, $CellContext`ecolC$, $CellContext`msgC$, \
$CellContext`colC$, $CellContext`p$, $CellContext`totalQ$, \
$CellContext`vcolQ$, $CellContext`ivals$, $CellContext`violI$, \
$CellContext`totalI$, $CellContext`vcolI$, $CellContext`ecolI$, \
$CellContext`msgI$, $CellContext`colI$, $CellContext`panelC$, \
$CellContext`panelQ$, $CellContext`panelI$}, $CellContext`selC$ = Flatten[
            
            Position[{$CellContext`b0$$, $CellContext`b1$$, \
$CellContext`b2$$, $CellContext`b3$$, $CellContext`b4$$}, True]] - 
          1; $CellContext`violC$ = 
         Select[{{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 0}}, And[
            MemberQ[$CellContext`selC$, 
             Part[#, 1]], 
            MemberQ[$CellContext`selC$, 
             Part[#, 2]]]& ]; $CellContext`scoreC$ = 
         Length[$CellContext`selC$]; {$CellContext`msgC$, $CellContext`colC$} = 
         If[Length[$CellContext`violC$] > 0, {"illegal", Red}, {
           "score = " <> ToString[$CellContext`scoreC$] <> " (ceiling 2)", 
            If[$CellContext`scoreC$ <= 2, 
             Darker[Green], Orange]}]; $CellContext`vcolC$ = 
         Table[$CellContext`i -> If[
             MemberQ[$CellContext`selC$, $CellContext`i], 
             Darker[Green], LightGray], {$CellContext`i, 0, 
            4}]; $CellContext`ecolC$ = Table[UndirectedEdge[
             
             Part[{{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 0}}, $CellContext`k, 
              1], 
             
             Part[{{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 0}}, $CellContext`k, 
              2]] -> If[
             MemberQ[$CellContext`violC$, 
              Part[{{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 0}}, $CellContext`k]],
              Red, Gray], {$CellContext`k, 5}]; $CellContext`panelC$ = Column[{
            Graph[
             Range[0, 4], 
             MapApply[
             UndirectedEdge, {{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 0}}], 
             VertexLabels -> "Name", VertexStyle -> $CellContext`vcolC$, 
             EdgeStyle -> $CellContext`ecolC$, VertexSize -> 0.3, GraphLayout -> 
             "CircularEmbedding", ImageSize -> 220, PlotLabel -> 
             Style["classical", Bold]], 
            
            Style[$CellContext`msgC$, $CellContext`colC$, Bold, 
             11]}]; $CellContext`p$ = Function[$CellContext`beta$, 
           Table[
            N[Dot[{
                Sin[$CellContext`beta$], 0, 
                Cos[$CellContext`beta$]}, 
               
               Part[{{(1 + 
                   Rational[-1, 4] ((1 + 5^Rational[1, 2])/(1 + 
                    Rational[1, 4] (1 + 5^Rational[1, 2]))))^Rational[1, 2], 
                  0, Rational[
                   1, 2] ((1 + 5^Rational[1, 2])/(1 + 
                    Rational[1, 4] (1 + 5^Rational[1, 2])))^Rational[1, 2]}, {
                 Rational[1, 4] (-1 - 5^
                   Rational[1, 2]) (1 + 
                    Rational[-1, 4] ((1 + 5^Rational[1, 2])/(1 + 
                    Rational[1, 4] (1 + 5^Rational[1, 2]))))^
                   Rational[1, 2], ((Rational[5, 8] + 
                    Rational[-1, 8] 5^Rational[1, 2]) (1 + 
                    Rational[-1, 4] ((1 + 5^Rational[1, 2])/(1 + 
                    Rational[1, 4] (1 + 5^Rational[1, 2])))))^Rational[1, 2], 
                  Rational[
                   1, 2] ((1 + 5^Rational[1, 2])/(1 + 
                    Rational[1, 4] (1 + 5^Rational[1, 2])))^Rational[1, 2]}, {
                 Rational[1, 4] (-1 + 
                   5^Rational[1, 2]) (1 + 
                    Rational[-1, 4] ((1 + 5^Rational[1, 2])/(1 + 
                    Rational[1, 4] (1 + 5^Rational[1, 2]))))^
                   Rational[
                    1, 2], -((Rational[5, 8] + 
                    Rational[1, 8] 5^Rational[1, 2]) (1 + 
                    Rational[-1, 4] ((1 + 5^Rational[1, 2])/(1 + 
                    Rational[1, 4] (1 + 5^Rational[1, 2])))))^Rational[1, 2], 
                  Rational[
                   1, 2] ((1 + 5^Rational[1, 2])/(1 + 
                    Rational[1, 4] (1 + 5^Rational[1, 2])))^Rational[1, 2]}, {
                 Rational[1, 4] (-1 + 
                   5^Rational[1, 2]) (1 + 
                    Rational[-1, 4] ((1 + 5^Rational[1, 2])/(1 + 
                    Rational[1, 4] (1 + 5^Rational[1, 2]))))^
                   Rational[1, 2], ((Rational[5, 8] + 
                    Rational[1, 8] 5^Rational[1, 2]) (1 + 
                    Rational[-1, 4] ((1 + 5^Rational[1, 2])/(1 + 
                    Rational[1, 4] (1 + 5^Rational[1, 2])))))^Rational[1, 2], 
                  Rational[
                   1, 2] ((1 + 5^Rational[1, 2])/(1 + 
                    Rational[1, 4] (1 + 5^Rational[1, 2])))^Rational[1, 2]}, {
                 Rational[1, 4] (-1 - 5^
                   Rational[1, 2]) (1 + 
                    Rational[-1, 4] ((1 + 5^Rational[1, 2])/(1 + 
                    Rational[1, 4] (1 + 5^Rational[1, 2]))))^
                   Rational[
                    1, 2], -((Rational[5, 8] + 
                    Rational[-1, 8] 5^Rational[1, 2]) (1 + 
                    Rational[-1, 4] ((1 + 5^Rational[1, 2])/(1 + 
                    Rational[1, 4] (1 + 5^Rational[1, 2])))))^Rational[1, 2], 
                  Rational[
                   1, 2] ((1 + 5^Rational[1, 2])/(1 + 
                    Rational[1, 4] (1 + 5^Rational[1, 2])))^
                   Rational[1, 2]}}, $CellContext`i + 1]]^2], {$CellContext`i,
              0, 4}]][$CellContext`beta$$]; $CellContext`totalQ$ = 
         Total[$CellContext`p$]; $CellContext`vcolQ$ = 
         Table[$CellContext`i -> Blend[{White, 
              RGBColor[0.2, 0.45, 0.85]}, 
             Part[$CellContext`p$, $CellContext`i + 1]], {$CellContext`i, 0, 
            4}]; $CellContext`panelQ$ = Column[{
            Graph[
             Range[0, 4], 
             MapApply[
             UndirectedEdge, {{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 0}}], 
             VertexLabels -> "Name", VertexStyle -> $CellContext`vcolQ$, 
             VertexSize -> 0.3, GraphLayout -> "CircularEmbedding", ImageSize -> 
             220, PlotLabel -> Style["quantum", Bold]], 
            Style["score = " <> ToString[
               NumberForm[$CellContext`totalQ$, 4]] <> 
             " (max \[Sqrt]5 at \[Beta]=0)", 
             Darker[Blue], Bold, 
             11]}]; $CellContext`ivals$ = {$CellContext`i0$$, \
$CellContext`i1$$, $CellContext`i2$$, $CellContext`i3$$, $CellContext`i4$$}; \
$CellContext`violI$ = 
         Select[{{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 0}}, 
           Part[$CellContext`ivals$, Part[#, 1] + 1] + 
            Part[$CellContext`ivals$, Part[#, 2] + 1] > 
           1& ]; $CellContext`totalI$ = 
         Total[$CellContext`ivals$]; $CellContext`vcolI$ = 
         Table[$CellContext`i -> Blend[{White, 
              RGBColor[0.75, 0.2, 0.2]}, 
             Part[$CellContext`ivals$, $CellContext`i + 1]], {$CellContext`i, 
            0, 4}]; $CellContext`ecolI$ = Table[UndirectedEdge[
             
             Part[{{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 0}}, $CellContext`k, 
              1], 
             
             Part[{{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 0}}, $CellContext`k, 
              2]] -> If[
             MemberQ[$CellContext`violI$, 
              Part[{{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 0}}, $CellContext`k]],
              Red, Gray], {$CellContext`k, 
            5}]; {$CellContext`msgI$, $CellContext`colI$} = 
         If[Length[$CellContext`violI$] > 0, {"illegal", Red}, {
           "score = " <> ToString[
              NumberForm[$CellContext`totalI$, 3]] <> " (ceiling 5/2)", 
            If[$CellContext`totalI$ <= 2.5 + 10^(-9), 
             Darker[Green], Orange]}]; $CellContext`panelI$ = Column[{
            Graph[
             Range[0, 4], 
             MapApply[
             UndirectedEdge, {{0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 0}}], 
             VertexLabels -> "Name", VertexStyle -> $CellContext`vcolI$, 
             EdgeStyle -> $CellContext`ecolI$, VertexSize -> 0.3, GraphLayout -> 
             "CircularEmbedding", ImageSize -> 220, PlotLabel -> 
             Style["classical light (non-classical)", Bold]], 
            Style[$CellContext`msgI$, $CellContext`colI$, Bold, 11]}]; 
        Row[{$CellContext`panelC$, $CellContext`panelQ$, \
$CellContext`panelI$}, 
          Spacer[16]]], "Specifications" :> {Delimiter, 
        Style[
        "classical: pick yes/no answers", 
         Bold], {{$CellContext`b0$$, False, "v0"}, {
         False, True}}, {{$CellContext`b1$$, False, "v1"}, {
         False, True}}, {{$CellContext`b2$$, False, "v2"}, {
         False, True}}, {{$CellContext`b3$$, False, "v3"}, {
         False, True}}, {{$CellContext`b4$$, False, "v4"}, {False, True}}, 
        Delimiter, 
        Style[
        "quantum: tilt the state", 
         Bold], {{$CellContext`beta$$, 0, "state tilt \[Beta]"}, 0, 1.2}, 
        Delimiter, 
        Style[
        "classical light: set 5 independent intensities", 
         Bold], {{$CellContext`i0$$, 0.5, "i0"}, 0, 
         1}, {{$CellContext`i1$$, 0.5, "i1"}, 0, 
         1}, {{$CellContext`i2$$, 0.5, "i2"}, 0, 
         1}, {{$CellContext`i3$$, 0.5, "i3"}, 0, 
         1}, {{$CellContext`i4$$, 0.5, "i4"}, 0, 1}}, "Options" :> {}, 
      "DefaultOptions" :> {}],
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    SynchronousInitialization->True,
    UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
    UnsavedVariables:>{Typeset`initDone$$},
    UntrackedVariables:>{Typeset`size$$}], "Manipulate",
   Deployed->True,
   StripOnInput->False],
  Manipulate`InterpretManipulate[1]]], "Output",ExpressionUUID->"e0edba18-\
3de7-4e00-8f72-15efa67fa7ee"],

Cell["\<\
The three panels are honestly different kinds of object, not three difficulty \
settings on the same game. The classical panel commits to a definite yes/no \
for each question in advance, capped at 2 by the pentagon's independence \
number. The quantum panel commits to nothing in advance; one state is \
measured five different ways, and its overlap with each measurement direction \
sets that question's own probability of 'yes' \[LongDash] all five equal, and \
summing to exactly Sqrt[5], only at the one symmetric state the slider starts \
on; tilt it and the total only ever falls, never rises. The classical-light \
panel is the odd one out: five independent intensities, free of any single \
consistent state, constrained only pairwise \[LongDash] exactly the \
fractional-packing relaxation of the classical panel's own rule, and exactly \
why it can reach higher, 5/2, without being quantum at all.\
\>", "Text",ExpressionUUID->"f999cb92-0b82-c745-86fe-89eed19d37b0"],

Cell["\<\
A third scoreboard \[LongDash] the contextual fraction. Slide the state \
parameter t and watch each pentagon vertex's colour intensity and the \
contextual fraction CF(t) = Max[0, 10 t \[Minus] 4] move together. Reused \
from TheBlackBoxGame.nb:\
\>", "CodeText",ExpressionUUID->"195b37f5-705e-a947-b949-099510d5f2a4"],

Cell["\<\
cfBoard = Manipulate[
  Module[{cf, vcol, msg},
   cf = Max[0, 10 t - 4];
   vcol = Table[i -> Blend[{White, RGBColor[0.6, 0.2, 0.7]}, t/0.5], {i, 1, \
5}];
   msg = \"CF(t) = \" <> ToString[NumberForm[cf, 4]] <>
     If[cf == 0, \"  -- noncontextual (t <= 2/5)\", \"  -- a second, \
independent scoreboard from the \[Theta]-\[Alpha] gap\"];
   Column[{
     Row[{
       Graph[CycleGraph[5], VertexLabels -> \"Name\", VertexStyle -> vcol, \
VertexSize -> 0.3,
        GraphLayout -> \"CircularEmbedding\", ImageSize -> 200, PlotLabel -> \
Style[\"t = \" <> ToString[NumberForm[t, 3]], 10]],
       Spacer[15],
       Plot[Max[0, 10 x - 4], {x, 0.3, 0.5}, PlotRange -> {0, 1}, ImageSize \
-> 260,
        Epilog -> {PointSize[0.02], Darker[Purple], Point[{t, cf}]},
        AxesLabel -> {\"t\", \"CF(t)\"}, PlotLabel -> Style[\"contextual \
fraction, exact\", 10]]
       }],
     Style[msg, Darker[Purple], Bold, 11]
     }]
   ],
  {{t, 0.4, \"single-event probability t\"}, 0.3, 0.5, 0.001}
  ]\
\>", "Input",
 Evaluatable->False,ExpressionUUID->"49f0d297-4643-4d4a-aea2-4e07161d8708"],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`t$$ = 0.4, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{{
       Hold[$CellContext`t$$], 0.4, "single-event probability t"}, 0.3, 0.5, 
      0.001, ControlType -> Manipulator}}, Typeset`size$$ = Automatic, 
    Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, "Variables" :> {$CellContext`t$$ = 0.4}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
