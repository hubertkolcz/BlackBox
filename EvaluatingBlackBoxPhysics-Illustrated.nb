ic, {Right, Top}] - DynamicLocation["VertexID$1", Automatic, {Left, Bottom}])*((1 + {-1., 0.3249196962329073})/2)], -2*Dynamic[DynamicLocation["VertexID$1", Automatic, {Left, Bottom}] + (DynamicLocation["VertexID$1", Automatic, {Right, Top}] - DynamicLocation["VertexID$1", Automatic, {Left, Bottom}])*{-1., 0.3249196962329073}], BaseStyle -> "Graphics"]}, "DynamicName", BoxID -> "VertexLabelID$1"], TagBox[{TagBox[DiskBox[{-7.044813998280222*^-16, 1.}, 0.11755705045849454], "DynamicName", BoxID -> "VertexID$2"], InsetBox[FormBox[StyleBox["\"P1\"", GrayLevel[0.2], Bold, FontFamily -> "Helvetica", 12, StripOnInput -> False], TraditionalForm], Dynamic[DynamicLocation["VertexID$2", Automatic, {Left, Bottom}] + (DynamicLocation["VertexID$2", Automatic, {Right, Top}] - DynamicLocation["VertexID$2", Automatic, {Left, Bottom}])*((1 + {-7.044813998280222*^-16, 1.})/2)], -2*Dynamic[DynamicLocation["VertexID$2", Automatic, {Left, Bottom}] + (DynamicLocation["VertexID$2", Automatic, {Right, Top}] - DynamicLocation["VertexID$2", Automatic, {Left, Bottom}])*{-7.044813998280222*^-16, 1.}], BaseStyle -> "Graphics"]}, "DynamicName", BoxID -> "VertexLabelID$2"], TagBox[{TagBox[DiskBox[{0.9510565162951533, 0.30901699437494634}, 0.11755705045849454], "DynamicName", BoxID -> "VertexID$3"], InsetBox[FormBox[StyleBox["\"P2\"", GrayLevel[0.2], Bold, FontFamily -> "Helvetica", 12, StripOnInput -> False], TraditionalForm], Dynamic[DynamicLocation["VertexID$3", Automatic, {Left, Bottom}] + (DynamicLocation["VertexID$3", Automatic, {Right, Top}] - DynamicLocation["VertexID$3", Automatic, {Left, Bottom}])*((1 + {0.9999999999999999, 0.32491969623290523})/2)], -2*Dynamic[DynamicLocation["VertexID$3", Automatic, {Left, Bottom}] + (DynamicLocation["VertexID$3", Automatic, {Right, Top}] - DynamicLocation["VertexID$3", Automatic, {Left, Bottom}])*{0.9999999999999999, 0.32491969623290523}], BaseStyle -> "Graphics"]}, "DynamicName", BoxID -> "VertexLabelID$3"], TagBox[{TagBox[DiskBox[{0.5877852522924738,