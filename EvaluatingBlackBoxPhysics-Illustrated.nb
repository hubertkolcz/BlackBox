        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`cf$, $CellContext`vcol$, $CellContext`msg$}, \
$CellContext`cf$ = Max[0, 10 $CellContext`t$$ - 4]; $CellContext`vcol$ = 
         Table[$CellContext`i -> Blend[{White, 
              RGBColor[0.6, 0.2, 0.7]}, $CellContext`t$$/
             0.5], {$CellContext`i, 1, 5}]; $CellContext`msg$ = 
         "CF(t) = " <> ToString[
            NumberForm[$CellContext`cf$, 4]] <> 
          If[$CellContext`cf$ == 0, "  -- noncontextual (t <= 2/5)", 
            "  -- a second, independent scoreboard from the \[Theta]-\[Alpha] \
gap"]; Column[{
           Row[{
             Graph[
              CycleGraph[5], VertexLabels -> "Name", 
              VertexStyle -> $CellContext`vcol$, VertexSize -> 0.3, 
              GraphLayout -> "CircularEmbedding", ImageSize -> 200, PlotLabel -> 
              Style["t = " <> ToString[
                  NumberForm[$CellContext`t$$, 3]], 10]], 
             Spacer[15], 
             Plot[
              Max[0, 10 $CellContext`x - 4], {$CellContext`x, 0.3, 0.5}, 
              PlotRange -> {0, 1}, ImageSize -> 260, Epilog -> {
                PointSize[0.02], 
                Darker[Purple], 
                Point[{$CellContext`t$$, $CellContext`cf$}]}, 
              AxesLabel -> {"t", "CF(t)"}, PlotLabel -> 
              Style["contextual fraction, exact", 10]]}], 
           Style[$CellContext`msg$, 
            Darker[Purple], Bold, 11]}]], 
      "Specifications" :> {{{$CellContext`t$$, 0.4, 
          "single-event probability t"}, 0.3, 0.5, 0.001}}, "Options" :> {}, 
      "DefaultOptions" :> {}],
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    SynchronousInitialization->True,
    UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
    UnsavedVariables:>{Typeset`initDone$$},
    UntrackedVariables:>{Typeset`size$$}], "Manipulate",
   Deployed->True,
   StripOnInput->False],
  Manipulate`InterpretManipulate[1]]], "Output",ExpressionUUID->"b9ae79de-\
936d-4448-b179-62df20fbc946"],

Cell["\<\
In the classical reading no edge may join two TRUEs, so at most two of the \
five events fire and the sum caps at 2. In the quantum reading every event \
gets the same cos^2 weight from the Lov\[AAcute]sz umbrella, and the five add \
to exactly Sqrt[5]. In the exclusivity-only reading every pairwise-exclusive \
family sums to at most one, allowing one-half everywhere and a total of 5/2. \
Re-derive the triple directly, in exact arithmetic:\
\>", "Text",ExpressionUUID->"20126b06-ead0-0241-9db2-0a2195d726b2"],

Cell["\<\
Cyclic orthogonality of the KCBS rays, and the three bounds, computed \
in-kernel:\
\>", "CodeText",ExpressionUUID->"ac331296-8db7-8b46-87a5-e9f18a796800"],

Cell[CellGroupData[{

Cell["\<\
c2 = Cos[Pi/5]/(1 + Cos[Pi/5]);
vecs = Table[{Sqrt[1 - c2] Cos[4 Pi i/5], Sqrt[1 - c2] Sin[4 Pi i/5], \
Sqrt[c2]}, {i, 0, 4}];
Column[{
  Row[{\"adjacent orthogonality:   \",
    Table[Simplify[vecs[[i]] . vecs[[Mod[i, 5] + 1]]], {i, 1, 5}]}],
  Row[{\"{\[Alpha], \[Theta], \[Alpha]*} = \", {2, Sqrt[5], 5/2},
    \"   \[TildeEqual]   \", N[{2, Sqrt[5], 5/2}]}]
  }]\
\>", "Input",
 CellOpen->False,
 CellLabel->
  "In[742]:=",ExpressionUUID->"70da0aad-5d29-d446-8e3e-18c8af67b0e1"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{"\"adjacent orthogonality:   \"", 
       RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}]},
      "RowDefault"]},
    {
     TemplateBox[{"\"{\[Alpha], \[Theta], \[Alpha]*} = \"", 
       RowBox[{"{", 
         RowBox[{"2", ",", 
           SqrtBox["5"], ",", 
           FractionBox["5", "2"]}], "}"}], "\"   \[TildeEqual]   \"", 
       RowBox[{"{", 
         RowBox[{"2.`", ",", "2.23606797749979`", ",", "2.5`"}], "}"}]},
      "RowDefault"]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellChangeTimes->{3.9930477057459354`*^9},
 CellLabel->
  "Out[744]=",ExpressionUUID->"9768d27e-c7bb-2745-8f13-c907dc359ae4"]
}, Open  ]],

Cell["\<\
The orthogonality check returns {0,0,0,0,0} exactly, and \[Theta] = Sqrt[5] \
sits strictly between \[Alpha] = 2 and \[Alpha]* = 5/2. Gate C5 flags a \
device SUPRA-QUANTUM only when its node sum clears Sqrt[5]; the overhang from \
Sqrt[5] up to 5/2 is precisely the room a non-quantum-but-still-legal source \
could occupy. Keeping that overhang in mind is the difference between a test \
that works and one that is quietly fooled \[LongDash] as the next three \
stages show.\
\>", "Text",ExpressionUUID->"ca5cdf22-0fd4-0048-9d6a-2462afc77714"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Stage 3 \[LongDash] The Protocol: Building a Real Test", "Section",ExpressionUUID->"e784462c-3bb4-7447-a040-ee43805f365b"],

