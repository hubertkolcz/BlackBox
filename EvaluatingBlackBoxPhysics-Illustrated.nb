             Style["classical", Bold]], 
            
            Style[$CellContext`msgC$, $CellContext`colC$, Bold, 
             11]}]; $CellContext`p$ = Function[$CellContext`beta$, 
           Table[
            N[Dot[{
                Sin[$CellContext`beta$], 0, 
