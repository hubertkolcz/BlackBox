     StripOnInput->False,
     FontSize->9], {4, 2}], ArrowBox[{{0.9, 2}, {3.1, 2}}], InsetBox[
    StyleBox["\<\"glue one block (cis / trans)\"\>",
     StripOnInput->False,
     FontSize->8], {2, 2.3}], 
   {RGBColor[0.85, 0.45, 0.2], ArrowBox[{{-0.1, 1.8}, {-0.9, 0.5}}], 
    ArrowBox[{{3.9, 1.8}, {3.1, 0.5}}], InsetBox[
     StyleBox["\<\"correlation lens: CF density\"\>",
      StripOnInput->False,
      FontSize->8], {-0.7, 0.25}]}, 
   {RGBColor[0.2, 0.45, 0.85], ArrowBox[{{0.1, 1.8}, {0.9, 0.5}}], 
    ArrowBox[{{4.1, 1.8}, {4.9, 0.5}}], InsetBox[
     StyleBox["\<\"geometric lens: DLA\"\>",
      StripOnInput->False,
      FontSize->8], {4.7, 0.25}]}, 
   {RGBColor[1, 0, 0], InsetBox[
     StyleBox["\<\"\[Times]  the square does not commute: the two lenses \
decorrelate under gluing (LP-002)\"\>",
      StripOnInput->False,
      FontSize->9,
      FontWeight->Bold], {2, -0.7}]}},
  ImageSize->540,
  PlotRange->{{-2.4, 6.4}, {-1.1, 2.7}}]], "Output",
 CellChangeTimes->{3.9930477068487053`*^9},
 CellLabel->
  "Out[786]=",ExpressionUUID->"efcaee6b-13e8-1c44-8320-cf2e2fd12246"]
}, Open  ]],

Cell["\<\
The same nine composed meshes, projected both ways \[LongDash] the \
correlation even flips sign:\
\>", "CodeText",ExpressionUUID->"4e1a587e-c81a-894d-a73b-b1a5d1b08a17"],

Cell[CellGroupData[{

Cell["\<\
satFrac = {1.0000, 1.0000, 1.0000, 0.6667, 0.7500, 0.8000, 0.6667, 0.7500, \
0.8000};
auc = {0.6667, 0.6250, 0.6000, 0.5833, 0.5500, 0.5333, 0.5833, 0.5500, 0.5333};
cfDensity = {0.2130, 0.1597, 0.1278, 0.2130, 0.1597, 0.1278, 0.3832, 0.1597, \
0.1278};
panelA = ListPlot[Transpose[{satFrac, cfDensity}], PlotStyle -> RGBColor[.85, \
.45, .2],
   PlotMarkers -> Automatic, AxesLabel -> {\"DLA summary A\", \"CF density\"},
   PlotLabel -> \"trend down  (r = -0.43)\", ImageSize -> 250];
panelB = ListPlot[Transpose[{auc, cfDensity}], PlotStyle -> RGBColor[.2, .45, \
.85],
   PlotMarkers -> Automatic, AxesLabel -> {\"DLA summary B\", \"CF density\"},
   PlotLabel -> \"trend up  (r = +0.27)\", ImageSize -> 250];
Row[{panelA, panelB}, Spacer[12]]\
\>", "Input",
 CellOpen->False,
 CellLabel->
  "In[787]:=",ExpressionUUID->"2887c19c-a3d8-8449-92bf-cfe66d0f7ec8"],

