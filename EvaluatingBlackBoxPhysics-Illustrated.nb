              Part[$CellContext`activeMask$, $CellContext`i], 
              RGBColor[0.85, 0.3, 0.15], 
              RGBColor[0.2, 0.45, 0.85]], 
             PointSize[
              If[
               Part[$CellContext`activeMask$, $CellContext`i], 0.026, 0.013]], 
             Point[
              
              Part[$CellContext`witCoords$, $CellContext`i]]}, \
{$CellContext`i, 17}]}, Boxed -> False, ImageSize -> 420, SphericalRegion -> 
