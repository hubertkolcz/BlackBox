            MemberQ[$CellContext`selC$, 
             Part[#, 1]], 
            MemberQ[$CellContext`selC$, 
             Part[#, 2]]]& ]; $CellContext`scoreC$ = 
         Length[$CellContext`selC$]; {$CellContext`msgC$, $CellContext`colC$} = 
         If[Length[$CellContext`violC$] > 0, {"illegal", Red}, {
           "score = " <> ToString[$CellContext`scoreC$] <> " (ceiling 2)", 
            If[$CellContext`scoreC$ <= 2, 
             Darker[Green], Orange]}]; $CellContext`vcolC$ = 
         Table[$CellContext`i -> If[
             MemberQ[$CellContext`selC$, $CellContext`i], 
             Darker[Green], LightGray], {$CellContext`i, 0, 
            4}]; $CellContext`ecolC$ = Table[UndirectedEdge[
             Part[$CellContext`edgesP, $CellContext`k, 1], 
             Part[$CellContext`edgesP, $CellContext`k, 2]] -> If[
             MemberQ[$CellContext`violC$, 
              Part[$CellContext`edgesP, $CellContext`k]], Red, 
