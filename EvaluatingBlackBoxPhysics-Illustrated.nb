          GrayLevel[0.8], 
          Thickness[Tiny]]}},
    GridBoxFrame->{"Columns" -> None, "Rows" -> None},
    GridBoxItemSize->{"Columns" -> {22, 55}, "Rows" -> {{Automatic}}},
    GridBoxItemStyle->{"Columns" -> {{
         Directive[FontFamily -> "Helvetica", 11, 
          GrayLevel[0.18]]}}, "Rows" -> {{
         Directive[FontFamily -> "Helvetica", 11, 
          GrayLevel[0.18]]}}},
    GridBoxSpacings->{"Columns" -> {{2.2}}, "Rows" -> {{1.8}}}],
