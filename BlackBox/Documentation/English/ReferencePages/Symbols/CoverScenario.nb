Notebook[{Cell["CoverScenario", "ObjectName", ExpressionUUID -> "c782c20c-19a5-494b-a933-96594530a234"], Cell["CoverScenario[X, cover] gives the contextuality scenario of an arbitrary measurement cover as an association: measurements X, contexts = the elements of cover (ordered measurement lists), section order per context (Tuples of the outcome sets in context order), the Abramsky-Brandenburger incidence matrix \"Incidence\" relating deterministic global assignments to context sections, \"Assignments\" (all global assignments), and \"Outcomes\". CoverScenario[X, cover, outcomes] uses the outcome list outcomes for every measurement (default {0, 1}), or per-measurement outcome lists when outcomes is an association over X. CycleScenario[n] is the binary n-cycle special case.", "Usage", ExpressionUUID -> "c6f0e684-0c5a-42ce-be75-97da4a5084b1"], Cell["Basic Examples", "Section", ExpressionUUID -> "ff3dbc76-470f-4fa8-a190-7fe960bd175a"], Cell[BoxData[RowBox[{RowBox[{RowBox[{"CoverScenario", "[", RowBox[{RowBox[{"Range", "[", RowBox[{"0", ",", "4"}], "]"}], ",", RowBox[{"Table", "[", RowBox[{RowBox[{"{", RowBox[{"i", ",", RowBox[{"Mod", "[", RowBox[{RowBox[{"i", "+", "1"}], ",", "5"}], "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{"i", ",", "0", ",", "4"}], "}"}]}], "]"}]}], "]"}], "[", "\"Incidence\"", "]"}], "===", RowBox[{RowBox[{"CycleScenario", "[", "5", "]"}], "[", "\"Incidence\"", "]"}]}]], "Input", ExpressionUUID -> "eefe07a8-0447-4822-85ae-80c618c2bbf1"]}, FrontEndVersion -> "15.0 for Microsoft Windows (64-bit) (May 19, 2026)", StyleDefinitions -> "Default.nb", ExpressionUUID -> "7516d926-a2cc-4fa3-bbd8-5a9f5a202a49"]
(* End of Notebook Content *)
