Notebook[{
Cell["GlueGraphs", "ObjectName",ExpressionUUID->"2a60e513-3256-264a-9c82-21d5ea98030a"],

Cell["\<\
GlueGraphs[g, h, ident] glues graph h onto graph g identifying vertices by \
the rules ident: {hVertex -> gVertex, ...}. Shared edges are deduplicated \
regardless of orientation.\
\>", "Usage",ExpressionUUID->"13d6cf73-ec84-c24a-ad24-c43f58182943"],

Cell["Basic Examples", "Section",ExpressionUUID->"671b7681-ec69-f64e-89b6-f996b2e19036"],

Cell[BoxData[
 RowBox[{"GlueGraphs", "[", 
  RowBox[{
   RowBox[{"CycleGraph", "[", "5", "]"}], ",", " ", 
   RowBox[{"VertexReplace", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "5", "]"}], ",", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"Range", "[", "5", "]"}], " ", "->", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"6", ",", " ", "10"}], "]"}]}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"6", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"7", " ", "->", " ", "2"}]}], "}"}]}], "]"}]], "Input",Expression\
UUID->"8bb28d99-18da-8448-b819-47c050e29262"]
},
