Notebook[{
Cell["LovaszThetaSparse", "ObjectName",ExpressionUUID->"3f1a7c2e-90d1-4b47-9a52-6a1b0d2c88e1"],

Cell["\<\
LovaszThetaSparse[g] gives the Lov\[AAcute]sz number \[CurlyTheta](g) by \
chordal decomposition of the dual semidefinite program: one small block per \
maximal clique of a chordal extension of g, so the cost scales with the \
treewidth of g instead of its vertex count.\
\>", "Usage",ExpressionUUID->"5b2e4f61-2c3a-4f08-b1d4-7e9c0a53f2a7"],

Cell["\<\
LovaszThetaSparse[g, \"Certificate\"] returns an association that adds the \
eigenvalue-certified upper bound \[Lambda]max(J - B) of the recovered dual \
witness B and the clique statistics of the extension.\
\>", "Usage",ExpressionUUID->"8d0c6a95-14e7-4b7a-a1f3-2c5b9e40d6b8"],

Cell["Basic Examples", "Section",ExpressionUUID->"a4e82d17-6f50-4c2b-8e91-0b3d5c7a94f0"],

Cell[BoxData[
 RowBox[{"LovaszThetaSparse", "[",
  RowBox[{"PentagonChain", "[", "20", "]"}], "]"}]], "Input",ExpressionUUID->\
"c7b91e04-3a68-4d15-b2c9-8f0a6d42e513"],

Cell["Scope", "Section",ExpressionUUID->"e2f50b83-71c9-4a06-9d34-5a8c1b76d029"],

Cell[BoxData[
 RowBox[{"LovaszThetaSparse", "[",
  RowBox[{RowBox[{"CycleGraph", "[", "7", "]"}], ",",
   "\"\<Certificate\>\""}], "]"}]], "Input",ExpressionUUID->\
"f9a37c50-82d4-4e61-a0b5-3d6e9f18c742"]
},
