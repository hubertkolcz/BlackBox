Notebook[{
Cell["NoncontextualFraction", "ObjectName",ExpressionUUID->"a4e8e219-a297-274c-99f0-5bdc1fb0741c"],

Cell["\<\
NoncontextualFraction[scen, e] gives the noncontextual fraction NCF of the \
empirical model e in the scenario scen (Abramsky-Barbosa-Mansfield, PRL 119, \
050504): the maximal total weight of a subprobability mixture of \
deterministic global assignments dominated by e.\
\>", "Usage",ExpressionUUID->"49506106-5b1b-2442-a4eb-b14eea5269a3"],

Cell["Basic Examples", "Section",ExpressionUUID->"1f1da9b5-05bf-ff40-8083-6bf1158b3f62"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NoncontextualFraction", "[", 
   RowBox[{
    RowBox[{"CycleScenario", "[", "5", "]"}], ",", " ", 
    RowBox[{"CycleModel", "[", 
     RowBox[{"5", ",", " ", "\"\<Quantum\>\""}], "]"}], ",", " ", 
    RowBox[{"WorkingPrecision", " ", "->", " ", "Infinity"}]}], "]"}], " ", "//",
   " ", "FullSimplify"}]], "Input",ExpressionUUID->"6ed2ad85-1625-5244-988b-\
d383e613e935"]
},
