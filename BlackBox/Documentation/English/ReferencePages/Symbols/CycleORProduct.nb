Notebook[{Cell["CycleORProduct", "ObjectName", ExpressionUUID -> "ef83e7ef-24ee-4fe4-9762-a7419e8298c1"], Cell["CycleORProduct[{n1, n2, ...}] gives the OR (conormal) product of the cycles C_n1, C_n2, ... on explicit tuple vertices: joint events are exclusive iff exclusive in some factor. The composition primitive for Consistent-Exclusivity tests across independent experiments.", "Usage", ExpressionUUID -> "3eef68c2-d54b-4351-bfb8-8f5bab8e4e57"], Cell["Basic Examples", "Section", ExpressionUUID -> "00893e82-60a1-48c6-94b7-97fdc1339644"], Cell[BoxData[RowBox[{"Through", "[", RowBox[{RowBox[{"{", RowBox[{"VertexCount", ",", "EdgeCount"}], "}"}], "[", RowBox[{"CycleORProduct", "[", RowBox[{"{", RowBox[{"7", ",", "5"}], "}"}], "]"}], "]"}], "]"}]], "Input", ExpressionUUID -> "cdf03ef8-2017-4285-a254-5c016e85d8d4"]}, FrontEndVersion -> "15.0 for Microsoft Windows (64-bit) (May 19, 2026)", StyleDefinitions -> "Default.nb", ExpressionUUID -> "e88bbe95-3916-42a0-8b9e-5c5385f0b765"]
