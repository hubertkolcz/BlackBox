Notebook[{
Cell["CEFilter", "ObjectName",ExpressionUUID->"6caa0234-b665-e24f-bbdf-4c2aac1bf084"],

Cell["\<\
CEFilter[g, p] and CEFilter[g, p, k] apply the Consistent-Exclusivity filter \
at k copies (default 2) to the probability assignment p (a vector in \
VertexList order) on the exclusivity graph g: every maximal clique of the \
k-fold OR (conormal) power must carry total probability at most 1 under the \
factorization rule P(e1,...,ek) = p(e1)...p(ek). Returns an association with \
keys \"Passes\", \"ViolatingCliques\", \"Worst\", \"CliqueCount\", \"Omega\".\
\
\>", "Usage",ExpressionUUID->"79b2d8b7-ddd3-064e-960a-c4ec3f3ef20a"],

Cell["Basic Examples", "Section",ExpressionUUID->"c4aa5559-6a11-a848-998c-9fc83767e751"],

Cell[BoxData[
 RowBox[{"CEFilter", "[", 
  RowBox[{
   RowBox[{"CycleGraph", "[", "5", "]"}], ",", " ", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{
     RowBox[{"1", "/", "2"}], ",", " ", "5"}], "]"}]}], "]"}]], "Input",Expres\
sionUUID->"8586f8df-f45f-624e-845f-ccde32c8abb3"]
},
