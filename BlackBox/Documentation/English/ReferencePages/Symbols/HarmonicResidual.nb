Notebook[{
Cell["HarmonicResidual", "ObjectName",ExpressionUUID->"01717522-f630-b041-a106-e50ea53b29db"],

Cell["\<\
HarmonicResidual[delta, e] gives Norm[delta . e]: the no-disturbance \
(signalling) residual of the model e. It vanishes on every no-disturbance \
model and is provably blind to contextuality - use it as a projector \
diagnostic, not a contextuality measure.\
\>", "Usage",ExpressionUUID->"dc6d13fd-0a6e-de43-bc0c-a9a879e93af5"],

Cell["Basic Examples", "Section",ExpressionUUID->"84da5999-9e8a-0746-ac90-b41bc60f5889"],

Cell[BoxData[
 RowBox[{"HarmonicResidual", "[", 
  RowBox[{
   RowBox[{"CycleCoboundary", "[", "5", "]"}], ",", " ", 
   RowBox[{"N", "@", 
    RowBox[{"CycleModel", "[", 
     RowBox[{"5", ",", " ", "\"\<Quantum\>\""}], "]"}]}]}], "]"}]], "Input",Ex\
pressionUUID->"0e7582ef-382a-624d-bc85-c813da937086"]
},
