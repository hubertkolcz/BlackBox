Notebook[{
Cell["CycleCoboundary", "ObjectName",ExpressionUUID->"93d73334-34e8-4c48-a6eb-1c5a401eed9c"],

Cell["\<\
CycleCoboundary[n] gives the cellular-sheaf coboundary \[Delta] (2n x 4n) of \
the n-cycle cover with marginalization restriction maps (Hansen-Ghrist, \
arXiv:1808.01513): ker(\[Delta]\[Transpose]\[Delta]) = the no-disturbance \
models.\
\>", "Usage",ExpressionUUID->"546d2573-200e-6c45-9f32-300567773924"],

Cell["Basic Examples", "Section",ExpressionUUID->"a333204f-8377-ee4a-a122-7df8c5722e45"],

